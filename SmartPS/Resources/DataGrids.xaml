<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- BẢNG DỮ LIỆU PHẲNG SHIBA SUNSET: tiêu đề kem ấm, kẻ dọc nhạt, dòng thoáng -->
    <!-- Dùng: Style="{StaticResource ModernDataGridStyle}"                         -->
    <!-- ========================================================================= -->

    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="#FDF2E4"/>
    <SolidColorBrush x:Key="TableHeaderTextBrush" Color="#7A667C"/>
    <SolidColorBrush x:Key="TableRowHoverBrush" Color="#FFF8F0"/>
    <SolidColorBrush x:Key="TableRowSelectedBrush" Color="#FFF0E8"/>
    <!-- Đường ngăn cột: nhạt ở thân bảng, đậm hơn một chút ở tiêu đề để thấy chỗ kéo giãn cột -->
    <SolidColorBrush x:Key="TableColumnDividerBrush" Color="#F3E7DD"/>
    <SolidColorBrush x:Key="TableHeaderDividerBrush" Color="#E6D2C2"/>

    <!-- Vùng kéo đổi độ rộng cột: vô hình nhưng vẫn kéo được -->
    <Style x:Key="ModernColumnGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TableHeaderTextBrush}"/>
        <Setter Property="Background" Value="{StaticResource TableHeaderBackgroundBrush}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <ContentPresenter RecognizesAccessKey="False"/>
                                <Path x:Name="SortArrow" Visibility="Collapsed" Margin="6,0,0,0" Width="8" Height="5" Stretch="Uniform"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Data="M1,1 L5,5 L9,1"/>
                            </StackPanel>
                        </Border>
                        <!-- Vạch ngăn cột ở mép phải tiêu đề -->
                        <Rectangle Width="1" HorizontalAlignment="Right" Margin="0,9" Fill="{StaticResource TableHeaderDividerBrush}"/>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource ModernColumnGripperStyle}"/>
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource ModernColumnGripperStyle}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SortArrow" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource TableRowHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource TableRowSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ô dữ liệu: không viền focus, không đổi màu chữ khi chọn (màu chọn nằm ở dòng) -->
    <Style x:Key="ModernDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="42"/>
        <Setter Property="ColumnHeaderHeight" Value="38"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource DividerBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TableColumnDividerBrush}"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernDataGridColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource ModernDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource ModernDataGridCellStyle}"/>
    </Style>

    <!-- Mặc định áp dụng thiết kế Shiba Sunset cho toàn bộ DataGrid trong ứng dụng -->
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource ModernDataGridStyle}"/>
    <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}"/>

</ResourceDictionary>
