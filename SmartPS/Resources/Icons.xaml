    <!-- ========================================================================= -->
    <!-- 1. STYLE CHO ICON NÉT MẢNH TRÊN CÁC NÚT THAO TÁC NHỎ                      -->
    <!-- ========================================================================= -->
    <Style x:Key="CustomSvgIconStyle" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ButtonSvgIconStyle" TargetType="Path" BasedOn="{StaticResource CustomSvgIconStyle}">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    </Style>

