    <!-- ========================================================================= -->
    <!-- 6. STYLE ÁNH XẠ ĐỘNG CHO MENU & TAB (ĐẶT SAU CÁC DRAWINGIMAGE)            -->
    <!-- ========================================================================= -->

    <!-- Hình minh họa của mục menu: chọn theo Id phân hệ qua converter (không dùng StaticResource trong trigger) -->
    <Style x:Key="NavModuleIllustrationStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="Source" Value="{Binding Id, Converter={StaticResource ModuleIllustrationConverter}}"/>
    </Style>

    <!-- Hình minh họa của thẻ đang mở: chọn theo Item.Id của TabItemViewModel -->
    <Style x:Key="TabModuleIllustrationStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="Source" Value="{Binding Item.Id, Converter={StaticResource ModuleIllustrationConverter}}"/>
    </Style>

</ResourceDictionary>