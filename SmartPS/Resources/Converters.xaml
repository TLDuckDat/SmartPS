<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SmartPS.Resources.Converters">

    <!-- Chuyển đổi Boolean sang Visibility -->
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

    <!-- Chuyển đổi tên vai trò hệ thống sang ngôn ngữ địa phương hóa -->
    <conv:RoleLocalizedConverter x:Key="RoleLocalizedConverter"/>

</ResourceDictionary>
