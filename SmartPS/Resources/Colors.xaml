<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bảng Màu Chủ Đạo: Trắng & Băng (White & Ice Blue) -->

    <!-- Nền Ứng dụng & Thẻ (Backgrounds & Cards) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F8FC"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D9E6F2"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#E8F3FC"/>

    <!-- Ô Nhập Liệu (Inputs) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#0284C7"/>

    <!-- Chữ (Typography) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextCaretBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="TextBrandBrush" Color="#0369A1"/>

    <!-- Viền Phân Cách (Dividers & Lines) -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0"/>

    <!-- Màu Trạng Thái Lỗi / Cảnh Báo (Màu Pastel Sáng, Tinh Tế) -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FECACA"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B91C1C"/>

    <!-- Màu Trạng Thái Thành Công / Tiến Trình -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="ProgressIndicatorBrush" Color="#0284C7"/>

    <!-- Gradient Băng Tuyết cho Banner (Ice Frost Gradient) -->
    <LinearGradientBrush x:Key="BannerGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F2FE" Offset="0.0"/>
        <GradientStop Color="#EDF7FE" Offset="0.5"/>
        <GradientStop Color="#E2F0FD" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Gradient Nút Bấm Chính (Ice Sky to Ocean Blue) -->
    <LinearGradientBrush x:Key="PrimaryButtonGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0284C7" Offset="0.0"/>
        <GradientStop Color="#0369A1" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Huy hiệu Băng (Ice Badge) -->
    <SolidColorBrush x:Key="IceBadgeBackgroundBrush" Color="#DDF0FD"/>
    <SolidColorBrush x:Key="IceBadgeBorderBrush" Color="#BAE6FD"/>

</ResourceDictionary>
