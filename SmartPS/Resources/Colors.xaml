<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- FONT CHỮ & HỆ THỐNG MÀU SẮC SHIBA SUNSET (HDDAT-PORTFOLIO)                -->
    <!-- Phong cách: Warm Daylight (#FFF6EA) + Twilight Sunset (#1D1840 / #E8735A) -->
    <!-- ========================================================================= -->

    <!-- Font Chữ -->
    <FontFamily x:Key="AppFontFamily">pack://application:,,,/SmartPS;component/Resources/Fonts/#Be Vietnam Pro, pack://application:,,,/Resources/Fonts/#Be Vietnam Pro, Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="ScriptFontFamily">pack://application:,,,/SmartPS;component/Resources/Fonts/#Dancing Script, pack://application:,,,/Resources/Fonts/#Dancing Script, Segoe Script</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono</FontFamily>

    <!-- Nền Ứng dụng & Thẻ (Warm Daylight) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF6EA"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FDF2E4"/>
    <SolidColorBrush x:Key="SurfaceStrongBrush" Color="#F6E6D4"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#DFC7B9"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFDF9"/>
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#1D1840"/>

    <!-- Ô Nhập Liệu -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FFFDFB"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#DFC7B9"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#C89D89"/>
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#E8735A"/>

    <!-- Chữ & Kiểu hiển thị (Tím than trầm #3A2A3C tương phản cao, dịu mắt) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#3A2A3C"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#564258"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A667C"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#968298"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFF4EA"/>
    <SolidColorBrush x:Key="TextCaretBrush" Color="#E8735A"/>
    <SolidColorBrush x:Key="TextBrandBrush" Color="#E8735A"/>

    <!-- Viền Phân Cách -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E6D2C6"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#EFE0D6"/>

    <!-- Nút Bấm Chính: Cam San Hô (Terracotta Coral) -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#E8735A"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#D65F46"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#B84B34"/>
    <SolidColorBrush x:Key="PrimaryButtonGradientBrush" Color="#E8735A"/>

    <!-- Màu Nhấn Phụ (Hoàng hôn: Vàng mật ong, Tím hoàng hôn, Hồng san hô) -->
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#D9821E"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8E4479"/>
    <SolidColorBrush x:Key="AccentPurpleBgBrush" Color="#F6EBF3"/>
    <SolidColorBrush x:Key="AccentTealBrush" Color="#C85A8A"/>
    <SolidColorBrush x:Key="AccentTealBgBrush" Color="#FCEEF4"/>

    <!-- Trạng Thái Lỗi / Cảnh Báo -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FDE8E8"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#F5B4B4"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#C93B4B"/>

    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF3D6"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FCD98B"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B86B14"/>

    <!-- Trạng Thái Thành Công / Tiến Trình -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E6F9F0"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#9AE6C1"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#168A5B"/>

    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#F2E2D4"/>
    <SolidColorBrush x:Key="ProgressIndicatorBrush" Color="#E8735A"/>

    <!-- Banner Hoàng Hôn & Dải chuyển sắc -->
    <LinearGradientBrush x:Key="BannerGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B1640" Offset="0"/>
        <GradientStop Color="#3F2862" Offset="0.35"/>
        <GradientStop Color="#6A3A72" Offset="0.72"/>
        <GradientStop Color="#2A1E3C" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0A63A" Offset="0"/>
        <GradientStop Color="#E8735A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SunsetBadgeGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC46A" Offset="0"/>
        <GradientStop Color="#FF9A76" Offset="0.5"/>
        <GradientStop Color="#C85A8A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Huy hiệu cam đào nhạt -->
    <SolidColorBrush x:Key="IceBadgeBackgroundBrush" Color="#FFF0E8"/>
    <SolidColorBrush x:Key="IceBadgeBorderBrush" Color="#F7C8B4"/>

</ResourceDictionary>
