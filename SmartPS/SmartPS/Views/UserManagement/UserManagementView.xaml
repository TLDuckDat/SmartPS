<UserControl x:Class="SmartPS.Views.UserManagement.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:SmartPS.Views.Common"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: 4 Thẻ Thống Kê KPI -->
            <RowDefinition Height="*"/>    <!-- Row 1: Danh Sách Tài Khoản & Panel Tạo Tài Khoản -->
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- ROW 0: 4 THẺ THỐNG KÊ (KPI) PHẲNG CHUẨN LOB   -->
        <!-- ============================================== -->
        <Grid Grid.Row="0" Margin="16,14,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- KPI 1: Tổng tài khoản -->
            <Border Grid.Column="0" Margin="0,0,6,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PrimaryButtonBrush}" CornerRadius="4,0,0,4"/>
                    <StackPanel Grid.Column="1" Margin="14,12,14,12">
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_Total}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_TotalSub}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI 2: Quản trị viên (Admin) -->
            <Border Grid.Column="1" Margin="3,0,3,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource ErrorTextBrush}" CornerRadius="4,0,0,4"/>
                    <StackPanel Grid.Column="1" Margin="14,12,14,12">
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_Admin}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding AdminCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_AdminSub}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI 3: Quản lý (Manager) -->
            <Border Grid.Column="2" Margin="3,0,3,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource WarningTextBrush}" CornerRadius="4,0,0,4"/>
                    <StackPanel Grid.Column="1" Margin="14,12,14,12">
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_Manager}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ManagerCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_ManagerSub}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI 4: Nhân viên trực ca (Staff) -->
            <Border Grid.Column="3" Margin="6,0,0,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource SuccessTextBrush}" CornerRadius="4,0,0,4"/>
                    <StackPanel Grid.Column="1" Margin="14,12,14,12">
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_Staff}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding StaffCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Dash_Kpi_StaffSub}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================== -->
        <!-- ROW 1: BẢNG TÀI KHOẢN & FORM TẠO TÀI KHOẢN      -->
        <!-- ============================================== -->
        <Grid Grid.Row="1" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="450"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- CỘT 1: BẢNG DANH SÁCH TÀI KHOẢN -->
            <Border Grid.Column="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="4"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Bộ lọc & Tìm kiếm -->
                        <RowDefinition Height="*"/>    <!-- Bảng DataGrid danh sách -->
                    </Grid.RowDefinitions>

                    <!-- Header bảng: Tìm kiếm + Nút lọc + Nút mở form tạo user -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tiêu đề danh sách -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{DynamicResource Str_Dash_TableTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Str_Dash_TableSubtitle}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Thanh tìm kiếm trực tiếp -->
                        <Border Grid.Column="1"
                                Background="{StaticResource InputBackgroundBrush}"
                                BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="34"
                                MaxWidth="300"
                                HorizontalAlignment="Left"
                                Margin="0,0,12,0"
                                ToolTip="{DynamicResource Str_Dash_SearchPlaceholder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                      Width="13" Height="13"
                                      Stretch="Uniform"
                                      Fill="{StaticResource TextMutedBrush}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="SearchTextBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Str_Dash_SearchPlaceholder}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextDimBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Bộ lọc vai trò & Nút thêm tài khoản -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Filter_All}" Height="32" Padding="12,0" Margin="3,0" FontSize="11.5" Command="{Binding FilterRoleCommand}" CommandParameter="All"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Filter_Admin}" Height="32" Padding="12,0" Margin="3,0" FontSize="11.5" Command="{Binding FilterRoleCommand}" CommandParameter="Admin"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Filter_Manager}" Height="32" Padding="12,0" Margin="3,0" FontSize="11.5" Command="{Binding FilterRoleCommand}" CommandParameter="Manager"/>
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Filter_Staff}" Height="32" Padding="12,0" Margin="3,0" FontSize="11.5" Command="{Binding FilterRoleCommand}" CommandParameter="Staff"/>

                            <!-- Nút Thêm Tài Khoản Mới -->
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    Height="32" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding ToggleCreatePanelCommand}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Width="12" Height="12" Stretch="Uniform" Fill="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_Dash_Btn_AddUser}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid Danh sách người dùng -->
                    <DataGrid Grid.Row="1"
                              x:Name="UserDataGrid"
                              ItemsSource="{Binding DisplayedUsers}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeight="36"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single">

                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding EditUserCommand}"
                                          CommandParameter="{Binding SelectedItem, ElementName=UserDataGrid}"/>
                        </DataGrid.InputBindings>

                        <DataGrid.Resources>
                            <!-- Header canh giữa chuẩn -->
                            <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="6,8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Header canh trái đệm 14px -->
                            <Style x:Key="LeftHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11.5"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="14,8">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <Style x:Key="CenterTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>

                            <Style x:Key="LeftTextStyle" TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="14,0,14,0"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource IceBadgeBackgroundBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Cột Mã (Canh giữa) -->
                            <DataGridTextColumn Header=""
                                                Binding="{Binding UserId}"
                                                Width="60"
                                                HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                ElementStyle="{StaticResource CenterTextStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_Id}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- Cột Tên Đăng Nhập (Canh giữa) -->
                            <DataGridTextColumn Header=""
                                                Binding="{Binding Username}"
                                                Width="140"
                                                HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                ElementStyle="{StaticResource CenterTextStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_Username}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- Cột Họ Và Tên (Canh trái đệm 14px) -->
                            <DataGridTextColumn Header=""
                                                Binding="{Binding FullName}"
                                                Width="*"
                                                HeaderStyle="{StaticResource LeftHeaderStyle}"
                                                ElementStyle="{StaticResource LeftTextStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_FullName}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- Cột Vai Trò (Canh giữa) -->
                            <DataGridTextColumn Header=""
                                                Binding="{Binding Role.RoleName, Converter={StaticResource RoleLocalizedConverter}}"
                                                Width="120"
                                                HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                ElementStyle="{StaticResource CenterTextStyle}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_Role}"/>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- Cột Trạng Thái -->
                            <DataGridTemplateColumn Header=""
                                                    Width="140"
                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_Status}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border CornerRadius="2" Padding="8,3" HorizontalAlignment="Center"
                                                    Background="{StaticResource SuccessBackgroundBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="{DynamicResource Str_Status_Active}" FontSize="11" Foreground="{StaticResource SuccessTextBrush}" FontWeight="Medium"/>
                                            </Border>
                                            <Border CornerRadius="2" Padding="8,3" HorizontalAlignment="Center"
                                                    Background="{StaticResource ErrorBackgroundBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{DynamicResource Str_Status_Locked}" FontSize="11" Foreground="{StaticResource ErrorTextBrush}" FontWeight="Medium"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thao Tác -->
                            <DataGridTemplateColumn Header=""
                                                    Width="140"
                                                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{DynamicResource Str_Col_Actions}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="26"
                                                    Padding="12,0"
                                                    Margin="3,2"
                                                    Foreground="{StaticResource TextBrandBrush}"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    Background="#FFFFFF"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Str_Tooltip_EditUser}">
                                                <TextBlock Text="{DynamicResource Str_Action_Edit}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Button>

                                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="26"
                                                    Padding="12,0"
                                                    Margin="3,2"
                                                    Foreground="{StaticResource ErrorTextBrush}"
                                                    BorderBrush="{StaticResource ErrorBorderBrush}"
                                                    Background="#FFFFFF"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="{DynamicResource Str_Tooltip_DeleteUser}">
                                                <TextBlock Text="{DynamicResource Str_Action_Delete}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- CỘT 2: GRIDSPLITTER CO GIÃN -->
            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding IsCreatePanelVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- CỘT 3: FORM TẠO TÀI KHOẢN -->
            <Border Grid.Column="2"
                    Width="360"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="4"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="18"
                    Visibility="{Binding IsCreatePanelVisible, Converter={StaticResource BoolToVisConverter}}">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Header Form tạo mới -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str_CreateUser_Title}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Str_CreateUser_Subtitle}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="26" Height="26"
                                    Padding="0"
                                    Command="{Binding ToggleCreatePanelCommand}"
                                    ToolTip="{DynamicResource Str_Tooltip_ClosePanel}">
                                <TextBlock Text="✕" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Tên đăng nhập -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Str_CreateUser_UsernameLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewUsernameInput"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Họ và tên -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Str_CreateUser_FullNameLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="NewFullNameInput"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Mật khẩu -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Str_CreateUser_PasswordLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="NewPasswordInput"
                                                      Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="{StaticResource InputBackgroundBrush}"
                                                      InputBorderBrush="{StaticResource InputBorderBrush}"
                                                      InputFocusedBorderBrush="{StaticResource InputFocusedBorderBrush}"
                                                      InputForeground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Xác nhận mật khẩu -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Str_CreateUser_ConfirmPasswordLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="ConfirmPasswordInput"
                                                      Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="{StaticResource InputBackgroundBrush}"
                                                      InputBorderBrush="{StaticResource InputBorderBrush}"
                                                      InputFocusedBorderBrush="{StaticResource InputFocusedBorderBrush}"
                                                      InputForeground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Chọn vai trò -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{DynamicResource Str_CreateUser_RoleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding SelectedRole}"
                                      Height="36"
                                      FontSize="12.5"
                                      VerticalContentAlignment="Center"
                                      Background="{StaticResource InputBackgroundBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      BorderBrush="{StaticResource InputBorderBrush}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RoleName, Converter={StaticResource RoleLocalizedConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Nút bấm tạo tài khoản -->
                        <Button x:Name="CreateUserButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="{DynamicResource Str_CreateUser_BtnSubmit}"
                                Height="36"
                                Margin="0,12,0,0"
                                Command="{Binding CreateUserCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

