<UserControl x:Class="SmartPS.Views.Incidents.IncidentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">

            <!-- 1. Header Phân Hệ -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="24,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Str_Menu_Incidents}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Ghi nhận và xử lý sự cố bất thường: Mất thẻ vé, biển số mờ, xe đỗ quá giờ hoặc nghi vấn an ninh" 
                                   FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Nút bấm Làm mới dữ liệu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}"
                                Height="36" Padding="14,0"
                                Background="{StaticResource PrimaryButtonBrush}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Cập Nhật Sự Cố" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Hàng Thẻ KPI Sự Cố (3 Cột) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng sự cố ghi nhận -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TỔNG SỐ SỰ CỐ" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalIncidents, StringFormat='{}{0} vụ việc'}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryButtonBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="Được lập biên bản ghi nhận" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Đang chờ xử lý -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ĐANG XỬ LÝ (CHỜ GIẢI QUYẾT)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="⏳" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding PendingIncidents, StringFormat='{}{0} vụ'}" FontSize="26" FontWeight="Bold" Foreground="#B91C1C" Margin="0,8,0,2"/>
                        <TextBlock Text="Cần trưởng ca xác minh" FontSize="11.5" Foreground="#B91C1C"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Đã giải quyết an toàn -->
                <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ĐÃ XỬ LÝ HOÀN TẤT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="✅" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding ResolvedIncidents, StringFormat='{}{0} vụ'}" FontSize="26" FontWeight="Bold" Foreground="#15803D" Margin="0,8,0,2"/>
                        <TextBlock Text="Đã đối chiếu chứng từ hợp lệ" FontSize="11.5" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Thanh Tìm Kiếm Sự Cố -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Height="36">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Padding="0,0,8,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. Bảng Danh Sách Sự Cố & Thao Tác Xử Lý -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="DANH SÁCH BIÊN BẢN SỰ CỐ BÃI ĐỖ XE" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding FilteredIncidents.Count, StringFormat='Hiển thị {0} biên bản'}" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding FilteredIncidents}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeight="44"
                              MaxHeight="450"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Mã sự cố -->
                            <DataGridTextColumn Header="Mã Sự Cố" Binding="{Binding IncidentCode}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Loại sự cố -->
                            <DataGridTextColumn Header="Loại Sự Cố" Binding="{Binding IncidentType}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Biển số xe liên quan -->
                            <DataGridTextColumn Header="Biển Số Xe" Binding="{Binding LicensePlate}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Thời gian phát sinh -->
                            <DataGridTextColumn Header="Thời Gian" Binding="{Binding ReportedTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Người báo cáo -->
                            <DataGridTextColumn Header="Nhân Viên Trực" Binding="{Binding ReportedBy}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Hành động xử lý -->
                            <DataGridTemplateColumn Header="Thao Tác" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ResolveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsResolved, Converter={StaticResource BoolToVisConverter}}"
                                                Height="28" Padding="10,0" Margin="10,0"
                                                Background="#0284C7" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsResolved}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="✓ Giải Quyết" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
