<Window x:Class="SmartPS.Views.Dashboard.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:SmartPS.Views.Common"
        mc:Ignorable="d"
        Title="{DynamicResource Str_EditUser_WindowTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header banner -->
            <RowDefinition Height="*"/>    <!-- Content form -->
            <RowDefinition Height="Auto"/> <!-- Footer actions -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Section -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_EditUser_HeaderTitle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="{DynamicResource Str_EditUser_HeaderSubtitle}"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ROW 1: Content Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Margin="20,18">

                <!-- Tên đăng nhập & ID (Chỉ xem) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Str_EditUser_IdLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="UserIdInput"
                                 Text="{Binding UserId, Mode=OneWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsEnabled="False"
                                 FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Str_EditUser_UsernameLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="UsernameInput"
                                 Text="{Binding Username, Mode=OneWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsEnabled="False"
                                 FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Họ và tên -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Str_EditUser_FullNameLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameInput"
                             Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <!-- Vai trò (Role) & Trạng thái (IsActive) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vai trò -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{DynamicResource Str_EditUser_RoleLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RoleComboBox"
                                  ItemsSource="{Binding AvailableRoles}"
                                  SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                  Height="36"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RoleName, Converter={StaticResource RoleLocalizedConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Trạng thái -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{DynamicResource Str_EditUser_StatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusComboBox"
                                  SelectedIndex="{Binding StatusIndex, Mode=TwoWay}"
                                  Height="36"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1">
                            <ComboBoxItem Content="{DynamicResource Str_EditUser_StatusActive}"/>
                            <ComboBoxItem Content="{DynamicResource Str_EditUser_StatusLocked}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Khung đổi mật khẩu mới (Tùy chọn) -->
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_EditUser_ChangePasswordSection}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="{DynamicResource Str_EditUser_ChangePasswordHint}"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   Margin="0,2,0,10"/>

                        <!-- Mật khẩu mới (Có nút Ẩn/Hiện mật khẩu) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str_EditUser_NewPasswordLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="NewPasswordInput"
                                                      Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="#FFFFFF"
                                                      InputBorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Xác nhận mật khẩu mới (Có nút Ẩn/Hiện mật khẩu) -->
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_EditUser_ConfirmNewPasswordLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="ConfirmPasswordInput"
                                                      Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="#FFFFFF"
                                                      InputBorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ROW 2: FOOTER ACTIONS -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Str_Btn_Cancel}"
                        MinWidth="85"
                        Margin="4,0"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>

                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Str_Btn_Save}"
                        MinWidth="120"
                        Margin="4,0"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
