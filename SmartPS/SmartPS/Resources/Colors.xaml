<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- HỆ THỐNG MÀU SẮC CHUẨN WINDOWS LOB DESKTOP: PHẲNG, TƯƠNG PHẢN CAO, SẮC NÉT  -->
    <!-- ========================================================================= -->

    <!-- Nền Ứng dụng & Thẻ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#1E293B"/>

    <!-- Ô Nhập Liệu (Chuẩn Windows Form: Nền trắng, viền rõ nét, focus dứt khoát) -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputFocusedBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#1D4ED8"/>

    <!-- Chữ & Kiểu hiển thị (Đậm đà, sắc nét, dễ đọc trên màn hình máy tính) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextCaretBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="TextBrandBrush" Color="#1D4ED8"/>

    <!-- Viền Phân Cách (Sắc nét 1px, phân chia bố cục rõ ràng) -->
    <SolidColorBrush x:Key="AppBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0"/>

    <!-- Nút Bấm Chính: Màu phẳng Corporate Blue (Không dùng gradient) -->
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="#1E40AF"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="#172554"/>
    <SolidColorBrush x:Key="PrimaryButtonGradientBrush" Color="#1D4ED8"/>

    <!-- Trạng Thái Lỗi / Cảnh Báo -->
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#B91C1C"/>

    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#FDE68A"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="#B45309"/>

    <!-- Trạng Thái Thành Công / Tiến Trình -->
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#86EFAC"/>
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D"/>

    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="ProgressIndicatorBrush" Color="#1D4ED8"/>

    <!-- Banner & Huy hiệu đơn sắc -->
    <SolidColorBrush x:Key="BannerGradientBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="IceBadgeBackgroundBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="IceBadgeBorderBrush" Color="#BFDBFE"/>

</ResourceDictionary>
