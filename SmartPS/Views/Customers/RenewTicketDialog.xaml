<Window x:Class="SmartPS.Views.Customers.RenewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gia Hạn Vé Tháng" Height="410" Width="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Mã Vé:" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtTicketCode" Grid.Row="0" Margin="120,5,0,10" FontWeight="Bold" Foreground="#2563EB"/>
        
        <TextBlock Text="Khách Hàng:" Grid.Row="1" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCustomerInfo" Grid.Row="1" Margin="120,5,0,10" FontWeight="SemiBold"/>
        
        <TextBlock Text="Hạn Hiện Tại:" Grid.Row="2" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCurrentExpiry" Grid.Row="2" Margin="120,5,0,10" Foreground="#64748B"/>
        
        <TextBlock Text="Gói Gia Hạn:" Grid.Row="3" Margin="0,5,0,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="cboDuration" Grid.Row="3" Margin="120,0,0,10" Height="28" SelectedIndex="0" SelectionChanged="CboDuration_SelectionChanged">
            <ComboBoxItem Content="Gia hạn 1 Tháng"/>
            <ComboBoxItem Content="Gia hạn 3 Tháng"/>
            <ComboBoxItem Content="Gia hạn 6 Tháng"/>
        </ComboBox>
        
        <TextBlock Text="Mức Phí Thu:" Grid.Row="4" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtFee" Grid.Row="4" Margin="120,5,0,10" FontWeight="Bold" FontSize="15" Foreground="#059669" Text="0 đ"/>

        <TextBlock Text="Thanh Toán:" Grid.Row="5" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboPaymentMethod" Grid.Row="5" Margin="120,0,0,10" Height="28" SelectedIndex="0">
            <ComboBoxItem Content="Tiền mặt (Cash)"/>
            <ComboBoxItem Content="Chuyển khoản VietQR"/>
            <ComboBoxItem Content="Thẻ ngân hàng / POS"/>
        </ComboBox>

        <TextBlock Text="Hạn Dùng Mới:" Grid.Row="6" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtNewExpiry" Grid.Row="6" Margin="120,5,0,10" FontWeight="SemiBold" Foreground="#D97706" Text="--"/>
        
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Gia Hạn" Width="90" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
