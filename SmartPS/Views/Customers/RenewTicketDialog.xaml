<Window x:Class="SmartPS.Views.Customers.RenewTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Customers_RenewTitle}" Height="410" Width="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgTicketCode}" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtTicketCode" Grid.Row="0" Margin="120,5,0,10" FontWeight="Bold" Foreground="#2563EB"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgCustomer}" Grid.Row="1" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCustomerInfo" Grid.Row="1" Margin="120,5,0,10" FontWeight="SemiBold"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgCurrentExpiry}" Grid.Row="2" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCurrentExpiry" Grid.Row="2" Margin="120,5,0,10" Foreground="#64748B"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgRenewPlan}" Grid.Row="3" Margin="0,5,0,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="cboDuration" Grid.Row="3" Margin="120,0,0,10" Height="28" SelectedIndex="0" SelectionChanged="CboDuration_SelectionChanged">
            <ComboBoxItem Content="{DynamicResource Str_Customers_Renew1}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_Renew3}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_Renew6}"/>
        </ComboBox>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgRenewFee}" Grid.Row="4" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtFee" Grid.Row="4" Margin="120,5,0,10" FontWeight="Bold" FontSize="15" Foreground="#059669" Text="0 đ"/>

        <TextBlock Text="{DynamicResource Str_Customers_DlgPayment}" Grid.Row="5" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboPaymentMethod" Grid.Row="5" Margin="120,0,0,10" Height="28" SelectedIndex="0">
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayCash}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayVietQr}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayCard}"/>
        </ComboBox>

        <TextBlock Text="{DynamicResource Str_Customers_DlgNewExpiry}" Grid.Row="6" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtNewExpiry" Grid.Row="6" Margin="120,5,0,10" FontWeight="SemiBold" Foreground="#D97706" Text="--"/>
        
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="{DynamicResource Str_Customers_Renew}" Width="90" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
