<Window x:Class="SmartPS.Views.Customers.HouseholdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Customers_AddHousehold}" Height="280" Width="380" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgAptCode}" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBox x:Name="txtApartmentCode" Text="{Binding ApartmentCode, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Margin="110,0,0,10" Height="25"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgAptMaxVehicles}" Grid.Row="1" Margin="0,5,0,0"/>
        <Grid Grid.Row="1" Margin="110,0,0,10">
            <TextBox x:Name="txtMaxVehicles" Text="{Binding MaxVehicles, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Height="25"/>
            <TextBlock Text="(Để trống = theo cấu hình hệ thống)" IsHitTestVisible="False" Foreground="#94A3B8" Margin="8,4,0,0" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MaxVehicles}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgNotes}" Grid.Row="2" Margin="0,5,0,0"/>
        <TextBox x:Name="txtNotes" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Margin="110,0,0,10" Height="50" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="{DynamicResource Str_Common_Save}" Width="80" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
