<Window x:Class="SmartPS.Views.Customers.HouseholdDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Hộ Gia Đình Mới" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Mã Căn Hộ:" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBox x:Name="txtApartmentCode" Grid.Row="0" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="Số Xe Tối Đa:" Grid.Row="1" Margin="0,5,0,0"/>
        <TextBox x:Name="txtMaxVehicles" Text="2" Grid.Row="1" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="Ghi Chú:" Grid.Row="2" Margin="0,5,0,0"/>
        <TextBox x:Name="txtNotes" Grid.Row="2" Margin="100,0,0,10" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Lưu" Width="80" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>

