<Window x:Class="SmartPS.Views.Customers.CustomerImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Customers_ImportTitle}"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding FilePath, Mode=OneWay}"
                     IsReadOnly="True"
                     Height="34"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="1"
                    Content="{DynamicResource Str_Customers_ImportChooseFile}"
                    Command="{Binding ChooseFileCommand}"
                    Height="34"
                    Padding="12,0"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Content="{DynamicResource Str_Customers_ImportPreview}"
                    Command="{Binding PreviewCommand}"
                    Height="34"
                    Padding="12,0"
                    Margin="0,0,8,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Grid.Column="3"
                    Content="{DynamicResource Str_Common_Close}"
                    Click="BtnClose_Click"
                    Height="34"
                    Padding="12,0"/>
        </Grid>

        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ProgressBar Grid.Row="0"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             Height="8"
                             Minimum="0"
                             Maximum="100"/>
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding ProgressMessage}"
                               Foreground="#475569"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Str_Customers_ImportTotal}"/>
                        <TextBlock Text="{Binding TotalRows}" Margin="4,0,12,0" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Str_Customers_ImportValid}" Foreground="#15803D"/>
                        <TextBlock Text="{Binding ValidRows}" Margin="4,0,12,0" FontWeight="Bold" Foreground="#15803D"/>
                        <TextBlock Text="{DynamicResource Str_Customers_ImportWarnings}" Foreground="#B45309"/>
                        <TextBlock Text="{Binding WarningRows}" Margin="4,0,12,0" FontWeight="Bold" Foreground="#B45309"/>
                        <TextBlock Text="{DynamicResource Str_Customers_ImportErrors}" Foreground="#B91C1C"/>
                        <TextBlock Text="{Binding ErrorRows}" Margin="4,0,0,0" FontWeight="Bold" Foreground="#B91C1C"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeight="34"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="#E2E8F0"
                  BorderThickness="1"
                  Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Str_Customers_ImportRow}" Binding="{Binding RowNumber, Mode=OneWay}" Width="60"/>
                <DataGridTextColumn Header="{DynamicResource Str_Customers_DlgApartment}" Binding="{Binding ApartmentCode, Mode=OneWay}" Width="120"/>
                <DataGridTextColumn Header="{DynamicResource Str_Customers_ColFullName}" Binding="{Binding OwnerName, Mode=OneWay}" Width="180"/>
                <DataGridTextColumn Header="{DynamicResource Str_Common_Plate}" Binding="{Binding LicensePlate, Mode=OneWay}" Width="130"/>
                <DataGridTextColumn Header="{DynamicResource Str_Common_VehicleType}" Binding="{Binding VehicleTypeName, Mode=OneWay}" Width="150"/>
                <DataGridTextColumn Header="{DynamicResource Str_Customers_ImportStatus}" Binding="{Binding StatusText, Mode=OneWay}" Width="100"/>
                <DataGridTextColumn Header="{DynamicResource Str_Customers_ImportMessage}" Binding="{Binding Message, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource Str_Customers_ImportCancel}"
                    Command="{Binding CancelCommand}"
                    Height="34"
                    Padding="14,0"
                    Margin="0,0,8,0"/>
            <Button Content="{DynamicResource Str_Customers_ImportSave}"
                    Command="{Binding SaveCommand}"
                    Height="34"
                    Padding="14,0"
                    Background="#16A34A"
                    Foreground="White"
                    BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
