<Window x:Class="SmartPS.Views.Customers.ChangePlateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi Biển Số Vé Tháng" Height="380" Width="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgTicketCode}" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtTicketCode" Text="{Binding TicketCode}" Grid.Row="0" Margin="130,5,0,10" FontWeight="Bold" Foreground="#2563EB"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgCustomer}" Grid.Row="1" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCustomerInfo" Text="{Binding CustomerInfo}" Grid.Row="1" Margin="130,5,0,10" FontWeight="SemiBold"/>
        
        <TextBlock Text="Biển số hiện tại:" Grid.Row="2" Margin="0,5,0,0"/>
        <TextBlock x:Name="txtCurrentPlate" Text="{Binding CurrentPlate}" Grid.Row="2" Margin="130,5,0,10" FontWeight="Bold" Foreground="#D97706"/>
        
        <TextBlock Text="Phương tiện mới:" Grid.Row="3" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboNewVehicle" ItemsSource="{Binding AvailableVehicles}" SelectedItem="{Binding SelectedNewVehicle, Mode=TwoWay}" DisplayMemberPath="LicensePlate" Grid.Row="3" Margin="130,0,0,10" Height="28"/>
        
        <TextBlock Text="Lý do đổi:" Grid.Row="4" Margin="0,5,0,0"/>
        <TextBox x:Name="txtReason" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Grid.Row="4" Margin="130,0,0,10" Height="45" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Đổi Biển Số" Width="100" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
