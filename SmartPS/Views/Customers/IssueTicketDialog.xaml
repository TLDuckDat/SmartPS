<Window x:Class="SmartPS.Views.Customers.IssueTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Customers_IssuePass}" Height="370" Width="420" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgCustomer}" Grid.Row="0" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboCustomer" Grid.Row="0" Margin="110,0,0,10" Height="25" IsEditable="True" IsTextSearchEnabled="True" SelectionChanged="CboCustomer_SelectionChanged"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgVehicle}" Grid.Row="1" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboVehicle" Grid.Row="1" Margin="110,0,0,10" Height="25" SelectionChanged="CboVehicle_SelectionChanged"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgDuration}" Grid.Row="2" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboDuration" Grid.Row="2" Margin="110,0,0,10" Height="25" SelectedIndex="0" SelectionChanged="CboDuration_SelectionChanged">
            <ComboBoxItem Content="{DynamicResource Str_Customers_Months1}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_Months3}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_Months6}"/>
        </ComboBox>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgFee}" Grid.Row="3" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBlock x:Name="txtPricePreview" Grid.Row="3" Margin="110,5,0,10" FontWeight="Bold" FontSize="14" Foreground="#2563EB" Text="0 đ"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgPayment}" Grid.Row="4" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboPaymentMethod" Grid.Row="4" Margin="110,0,0,10" Height="25" SelectedIndex="0">
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayCash}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayVietQr}"/>
            <ComboBoxItem Content="{DynamicResource Str_Customers_PayCard}"/>
        </ComboBox>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Str_Common_Cancel}" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="{DynamicResource Str_Common_Save}" Width="80" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
