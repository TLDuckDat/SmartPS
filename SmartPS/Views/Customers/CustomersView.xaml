<UserControl x:Class="SmartPS.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cust="clr-namespace:SmartPS.Services.Customers"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <UserControl.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="CellBoldStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">

            <!-- 1. Header -->
            <Border Style="{StaticResource CardStyle}" Padding="24,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Str_Cust_Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str_Cust_Subtitle}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Dash_Btn_Refresh}" Padding="16,0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 2. Read-only notice (AC-10) -->
            <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{DynamicResource Str_Cust_ReadOnlyNotice}" TextWrapping="Wrap"
                           FontSize="12.5" Foreground="{StaticResource WarningTextBrush}"/>
            </Border>

            <TabControl Background="Transparent" BorderThickness="0">

                <!-- ===================== TAB: CUSTOMERS ===================== -->
                <TabItem Header="{DynamicResource Str_Cust_Tab_Customers}">
                    <StackPanel Margin="0,16,0,0">

                        <!-- KPI -->
                        <UniformGrid Rows="1" Margin="0,0,0,16">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_Cust_Kpi_Total}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding TotalCustomers}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryButtonBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_Cust_Kpi_Residents}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding ResidentCount}" FontSize="24" FontWeight="Bold" Foreground="#15803D" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_Cust_Kpi_ActiveTickets}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding ActiveTicketsCount}" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_Cust_Kpi_ExpiringSoon}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Str_Cust_Kpi_Revenue}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Text="{Binding ActiveTicketRevenueFormatted}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Search / filter / new -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         ToolTip="{DynamicResource Str_Cust_SearchHint}"/>
                                <ComboBox Grid.Column="1" Width="170" Height="36" Margin="12,0,0,0" VerticalContentAlignment="Center"
                                          SelectedValue="{Binding Filter, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{DynamicResource Str_Cust_Filter_All}" Tag="{x:Static cust:CustomerListFilter.All}"/>
                                    <ComboBoxItem Content="{DynamicResource Str_Cust_Filter_Residents}" Tag="{x:Static cust:CustomerListFilter.Residents}"/>
                                    <ComboBoxItem Content="{DynamicResource Str_Cust_Filter_NonResidents}" Tag="{x:Static cust:CustomerListFilter.NonResidents}"/>
                                </ComboBox>
                                <Button Grid.Column="2" Command="{Binding NewCustomerCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                        Content="{DynamicResource Str_Cust_New}" Margin="12,0,0,0" Padding="16,0"/>
                            </Grid>
                        </Border>

                        <!-- Customer list -->
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <DataGrid ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          RowHeight="38"
                                          MaxHeight="450"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                                          Background="Transparent"
                                          BorderThickness="1"
                                          BorderBrush="{StaticResource DividerBrush}"
                                          RowHeaderWidth="0"
                                          HeadersVisibility="Column"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding FullName}" Width="170" ElementStyle="{StaticResource CellBoldStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Name}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding PhoneNumber}" Width="110" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Phone}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding ApartmentCode}" Width="90" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Apartment}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding LicensePlatesText}" Width="170" ElementStyle="{StaticResource CellBoldStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Plates}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding TypeText}" Width="120" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Type}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="130">
                                            <DataGridTemplateColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_TicketStatus}"/></DataTemplate>
                                            </DataGridTemplateColumn.HeaderTemplate>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasActiveTicket}" Value="True">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding TicketStatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Binding="{Binding TicketEndText}" Width="100" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_TicketEnd}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding LockedText}" Width="*" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_Active}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding PrevPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Cust_PrevPage}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding PageInfoText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                    <Button Grid.Column="2" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Cust_NextPage}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Editor -->
                        <Border Style="{StaticResource CardStyle}" Padding="20" DataContext="{Binding Editor}"
                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel IsEnabled="{Binding CanManage}">

                                <!-- Profile -->
                                <WrapPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,12,10" Width="220">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_FullName}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="150">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Phone}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="220">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Email}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="160">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_IdentityCard}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding IdentityCard, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="130" VerticalAlignment="Bottom">
                                        <CheckBox IsChecked="{Binding IsResident}" Content="{DynamicResource Str_Cust_Field_IsResident}" Margin="0,0,0,10"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="140">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Apartment}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding ApartmentCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="100">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Building}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Building, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="160">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Type}" Style="{StaticResource FieldLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding TypeOptions}" SelectedValue="{Binding SelectedType, Mode=TwoWay}"
                                                  SelectedValuePath="Value" DisplayMemberPath="DisplayName" Height="36" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,10" Width="360">
                                        <TextBlock Text="{DynamicResource Str_Cust_Field_Notes}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Cust_Save}" Padding="18,0"/>
                                    <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Cust_Cancel}"/>
                                    <Button Command="{Binding ToggleActiveCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{Binding ToggleActiveText}"/>
                                </StackPanel>

                                <!-- Vehicles -->
                                <TextBlock Text="{DynamicResource Str_Cust_Vehicles}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding Vehicles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          RowHeight="34" MaxHeight="200" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{StaticResource DividerBrush}" Background="Transparent"
                                          BorderThickness="1" BorderBrush="{StaticResource DividerBrush}" RowHeaderWidth="0"
                                          HeadersVisibility="Column" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding LicensePlate}" Width="170" ElementStyle="{StaticResource CellBoldStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Field_Plate}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Binding="{Binding VehicleTypeName}" Width="*" ElementStyle="{StaticResource CellTextStyle}">
                                            <DataGridTextColumn.HeaderTemplate>
                                                <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Field_VehicleType}"/></DataTemplate>
                                            </DataGridTextColumn.HeaderTemplate>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="{DynamicResource Str_Cust_RemoveVehicle}" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" FontSize="11"
                                                            Command="{Binding DataContext.RemoveVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,16">
                                    <TextBox Text="{Binding NewVehiclePlate, UpdateSourceTrigger=PropertyChanged}" Width="180"
                                             Style="{StaticResource ModernTextBoxStyle}" ToolTip="{DynamicResource Str_Cust_Field_Plate}"/>
                                    <ComboBox ItemsSource="{Binding VehicleTypeOptions}" SelectedItem="{Binding NewVehicleType}" DisplayMemberPath="TypeName"
                                              Width="160" Height="36" Margin="10,0,0,0" VerticalContentAlignment="Center"/>
                                    <Button Command="{Binding AddVehicleCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Cust_AddVehicle}" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- Tickets (existing customers only) -->
                                <StackPanel Visibility="{Binding CanShowTickets, Converter={StaticResource BoolToVisConverter}}">
                                    <TextBlock Text="{DynamicResource Str_Cust_Tickets}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding Tickets}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              RowHeight="36" MaxHeight="240" GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="{StaticResource DividerBrush}" Background="Transparent"
                                              BorderThickness="1" BorderBrush="{StaticResource DividerBrush}" RowHeaderWidth="0"
                                              HeadersVisibility="Column" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding TicketCode}" Width="130" ElementStyle="{StaticResource CellBoldStyle}"/>
                                            <DataGridTextColumn Binding="{Binding LicensePlate}" Width="110" ElementStyle="{StaticResource CellTextStyle}">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Field_Plate}"/></DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding PlanName}" Width="190" ElementStyle="{StaticResource CellTextStyle}">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Field_Plan}"/></DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding StartText}" Width="95" ElementStyle="{StaticResource CellTextStyle}">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Field_StartDate}"/></DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding EndText}" Width="95" ElementStyle="{StaticResource CellTextStyle}">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_TicketEnd}"/></DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Binding="{Binding StatusText}" Width="110" ElementStyle="{StaticResource CellTextStyle}">
                                                <DataGridTextColumn.HeaderTemplate>
                                                    <DataTemplate><TextBlock Text="{DynamicResource Str_Cust_Col_TicketStatus}"/></DataTemplate>
                                                </DataGridTextColumn.HeaderTemplate>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="{DynamicResource Str_Cust_RenewTicket}" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" FontSize="11"
                                                                    Command="{Binding DataContext.RenewTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding Dto}"/>
                                                            <Button Content="{DynamicResource Str_Cust_SuspendTicket}" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" FontSize="11"
                                                                    Command="{Binding DataContext.SuspendTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding Dto}"/>
                                                            <Button Content="{DynamicResource Str_Cust_ResumeTicket}" Style="{StaticResource SecondaryButtonStyle}" Height="26" Padding="10,0" FontSize="11"
                                                                    Command="{Binding DataContext.ResumeTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding Dto}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,12,8" Width="170">
                                            <TextBlock Text="{DynamicResource Str_Cust_Field_Plate}" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding Vehicles}" SelectedItem="{Binding SelectedVehicle}" DisplayMemberPath="LicensePlate"
                                                      Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8" Width="240">
                                            <TextBlock Text="{DynamicResource Str_Cust_Field_Plan}" Style="{StaticResource FieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding PlanOptions}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="PlanName"
                                                      Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8" Width="150">
                                            <TextBlock Text="{DynamicResource Str_Cust_Field_StartDate}" Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Height="36" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,8" Width="220">
                                            <TextBlock Text="{DynamicResource Str_Cust_SuspendReason}" Style="{StaticResource FieldLabelStyle}"/>
                                            <TextBox Text="{Binding SuspendReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                        </StackPanel>
                                        <Button Command="{Binding CreateTicketCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Cust_CreateTicket}"
                                                VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="16,0"/>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ===================== TAB: BLACKLIST ===================== -->
                <TabItem Header="{DynamicResource Str_Cust_Tab_Blacklist}">
                    <StackPanel Margin="0,16,0,0" DataContext="{Binding Blacklist}">

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <WrapPanel Orientation="Horizontal" IsEnabled="{Binding CanManageBlacklist}">
                                    <StackPanel Margin="0,0,12,8" Width="170">
                                        <TextBlock Text="{DynamicResource Str_Blacklist_Plate}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding NewPlate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8" Width="380">
                                        <TextBlock Text="{DynamicResource Str_Blacklist_Reason}" Style="{StaticResource FieldLabelStyle}"/>
                                        <TextBox Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </StackPanel>
                                    <Button Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Blacklist_Add}"
                                            VerticalAlignment="Bottom" Margin="0,0,0,8" Padding="16,0"/>
                                </WrapPanel>
                                <CheckBox IsChecked="{Binding IncludeHistory}" Content="{DynamicResource Str_Blacklist_ShowHistory}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      RowHeight="36" MaxHeight="420" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource DividerBrush}" Background="Transparent"
                                      BorderThickness="1" BorderBrush="{StaticResource DividerBrush}" RowHeaderWidth="0"
                                      HeadersVisibility="Column" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding LicensePlate}" Width="130" ElementStyle="{StaticResource CellBoldStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_Plate}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Reason}" Width="260" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_Reason}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_CreatedAt}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding CreatedByUsername}" Width="110" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_CreatedBy}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Binding="{Binding IsActive, Mode=OneWay}" Width="90">
                                        <DataGridCheckBoxColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_Active}"/></DataTemplate>
                                        </DataGridCheckBoxColumn.HeaderTemplate>
                                    </DataGridCheckBoxColumn>
                                    <DataGridTextColumn Binding="{Binding RemovedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_RemovedAt}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding RemovedByUsername}" Width="110" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_RemovedBy}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding RemoveReason}" Width="*" ElementStyle="{StaticResource CellTextStyle}">
                                        <DataGridTextColumn.HeaderTemplate>
                                            <DataTemplate><TextBlock Text="{DynamicResource Str_Blacklist_RemoveReason}"/></DataTemplate>
                                        </DataGridTextColumn.HeaderTemplate>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" IsEnabled="{Binding CanManageBlacklist}">
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,12,0" Width="420">
                                    <TextBlock Text="{DynamicResource Str_Blacklist_RemoveReason}" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding RemoveReason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </StackPanel>
                                <Button Command="{Binding RemoveCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Blacklist_Remove}"
                                        VerticalAlignment="Bottom" Padding="16,0"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
