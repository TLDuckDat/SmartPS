<UserControl x:Class="SmartPS.Views.Customers.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">

            <!-- 1. Header Phân Hệ -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="24,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Str_Menu_Customers}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str_Customers_Subtitle}" 
                                   FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Nút bấm Làm mới dữ liệu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}"
                                Height="36" Padding="14,0"
                                Background="{StaticResource PrimaryButtonBrush}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Str_Customers_RefreshList}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Hàng Thẻ KPI Khách Hàng (4 Cột) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng khách hàng -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_Customers_KpiTotal}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryButtonBrush}" Margin="0,8,0,2"><Run Text="{Binding TotalCustomers, Mode=OneWay}"/><Run Text="{DynamicResource Str_Unit_ProfilesSuffix}"/></TextBlock>
                        <TextBlock Text="{DynamicResource Str_Customers_KpiTotalSub}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Vé tháng đang hoạt động -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_Customers_KpiActivePasses}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="🎟" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#15803D" Margin="0,8,0,2"><Run Text="{Binding ActiveTicketsCount, Mode=OneWay}"/><Run Text="{DynamicResource Str_Unit_PassesSuffix}"/></TextBlock>
                        <TextBlock Text="{DynamicResource Str_Customers_KpiActivePassesSub}" FontSize="11.5" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Sắp hết hạn (dưới 15 ngày) -->
                <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_Customers_KpiExpiring}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="⏰" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,2"><Run Text="{Binding ExpiringSoonCount, Mode=OneWay}"/><Run Text="{DynamicResource Str_Unit_PassesSuffix}"/></TextBlock>
                        <TextBlock Text="{DynamicResource Str_Customers_KpiExpiringSub}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Doanh thu vé tháng -->
                <Border Grid.Column="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str_Customers_KpiRevenue}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="💵" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding MonthlyRevenueTotalFormatted}" FontSize="22" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,2"/>
                        <TextBlock Text="{DynamicResource Str_Customers_KpiRevenueSub}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                <!-- TAB 1: KHÁCH HÀNG & PHƯƠNG TIỆN -->
                <TabItem Header="{DynamicResource Str_Customers_Title}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                    <StackPanel Margin="0,16,0,0">
                        <!-- 3. Thanh Tìm Kiếm Khách Hàng -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16"
                                Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="380"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Height="36">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 VerticalContentAlignment="Center"
                                                 FontSize="13"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Padding="0,0,8,0"/>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Customers_SortBy}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding CustomerSortOptions}" SelectedIndex="{Binding SelectedCustomerSortIndex}" Width="200" Height="34" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 4. Bảng Danh Sách Khách Hàng & Vé Tháng -->
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Customers_CustomersTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{DynamicResource Str_Customers_AddCustomer}" Command="{Binding AddCustomerCommand}" Padding="10,5" Margin="0,0,10,0" Background="#10B981" Foreground="White" BorderThickness="0"/>
                                        <Button Content="{DynamicResource Str_Customers_AddVehicle}" Command="{Binding AddVehicleCommand}" Padding="10,5" Margin="0,0,10,0" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                                        <Button Content="{DynamicResource Str_Common_Delete}" Command="{Binding DeleteCustomerCommand}" Padding="10,5" Background="#EF4444" Foreground="White" BorderThickness="0" ToolTip="{DynamicResource Str_Customers_DeleteCustomerTip}"/>
                                    </StackPanel>
                                </Grid>

                    <DataGrid ItemsSource="{Binding FilteredCustomers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeight="38"
                              MaxHeight="450"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Mã vé tháng -->
                            <DataGridTextColumn Header="{DynamicResource Str_Customers_ColPassCode}" Binding="{Binding MonthlyTicketCode}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Họ và tên -->
                            <DataGridTextColumn Header="{DynamicResource Str_Customers_ColFullName}" Binding="{Binding FullName}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Số điện thoại -->
                            <DataGridTextColumn Header="{DynamicResource Str_Customers_ColPhone}" Binding="{Binding PhoneNumber}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Biển số xe đăng ký -->
                            <DataGridTextColumn Header="{DynamicResource Str_Common_Plate}" Binding="{Binding DefaultLicensePlate}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Loại phương tiện -->
                            <DataGridTextColumn Header="{DynamicResource Str_Common_VehicleType}" Binding="{Binding VehicleTypeName}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Phân hạng -->
                            <DataGridTextColumn Header="{DynamicResource Str_Customers_ColTier}" Binding="{Binding CustomerTypeDisplay}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Hạn sử dụng vé -->
                            <DataGridTextColumn Header="{DynamicResource Str_Customers_ColValidUntil}" Binding="{Binding TicketExpiry, StringFormat={}{0:dd/MM/yyyy}}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="{DynamicResource Str_Customers_ColPassStatus}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasActiveTicket}" Value="True">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasActiveTicket}" Value="True">
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Thao tác xóa từng dòng -->
                            <DataGridTemplateColumn Header="{DynamicResource Str_Common_Actions}" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Str_Customers_DeleteVehicle}"
                                                ToolTip="{DynamicResource Str_Customers_DeleteVehicleTip}"
                                                Command="{Binding DataContext.DeleteRowVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3" Height="26"
                                                Background="#FEE2E2" Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" BorderThickness="1"
                                                FontSize="11" FontWeight="SemiBold"
                                                Cursor="Hand"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="4"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                
                <!-- TAB 2: QUẢN LÝ HỘ GIA ĐÌNH -->
                <TabItem Header="{DynamicResource Str_Customers_TabHouseholds}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Customers_HouseholdsTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Str_Customers_AddHousehold}" Command="{Binding AddHouseholdCommand}" Padding="10,5" Margin="0,0,10,0" Background="#10B981" Foreground="White" BorderThickness="0"/>
                                    <Button Content="{DynamicResource Str_Common_Delete}" Command="{Binding DeleteHouseholdCommand}" Padding="10,5" Background="#EF4444" Foreground="White" BorderThickness="0" ToolTip="{DynamicResource Str_Customers_DeleteHouseholdTip}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Thanh Tìm Kiếm & Sắp Xếp Hộ Gia Đình -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding HouseholdSearchKeyword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Padding="0,0,6,0"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Customers_SortBy}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding HouseholdSortOptions}" SelectedIndex="{Binding SelectedHouseholdSortIndex}" Width="190" Height="34" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding Households}" SelectedItem="{Binding SelectedHousehold}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" MaxHeight="550" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}" RowHeaderWidth="0" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColApartment}" Binding="{Binding ApartmentCode}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColMaxVehicles}" Binding="{Binding MaxVehicles}" Width="120"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Common_Notes}" Binding="{Binding Notes}" Width="*"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColCreatedAt}" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: QUẢN LÝ VÉ THÁNG -->
                <TabItem Header="{DynamicResource Str_Customers_TabPasses}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Customers_PassesTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Str_Customers_IssuePass}" Command="{Binding AddTicketCommand}" Padding="10,5" Margin="0,0,10,0" Background="#8B5CF6" Foreground="White" BorderThickness="0"/>
                                    <Button Content="{DynamicResource Str_Customers_LockToggle}" Command="{Binding ToggleTicketCommand}" Padding="10,5" Margin="0,0,10,0" Background="#F59E0B" Foreground="White" BorderThickness="0" ToolTip="{DynamicResource Str_Customers_LockToggleTip}"/>
                                    <Button Content="{DynamicResource Str_Customers_Renew}" Command="{Binding RenewTicketCommand}" Padding="10,5" Margin="0,0,10,0" Background="#3B82F6" Foreground="White" BorderThickness="0" ToolTip="{DynamicResource Str_Customers_RenewTip}"/>
                                    <Button Content="{DynamicResource Str_Customers_DeletePass}" Command="{Binding DeleteTicketCommand}" Padding="10,5" Background="#EF4444" Foreground="White" BorderThickness="0" ToolTip="{DynamicResource Str_Customers_DeletePassTip}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Thanh Tìm Kiếm & Sắp Xếp Vé Tháng -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Height="34">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBox Grid.Column="1" Text="{Binding TicketSearchKeyword, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Padding="0,0,6,0"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str_Customers_SortBy}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,8,0"/>
                                        <ComboBox ItemsSource="{Binding TicketSortOptions}" SelectedIndex="{Binding SelectedTicketSortIndex}" Width="220" Height="34" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataGrid ItemsSource="{Binding Tickets}" SelectedItem="{Binding SelectedTicket}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="38" MaxHeight="550" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource DividerBrush}" Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}" RowHeaderWidth="0" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColTicket}" Binding="{Binding TicketCode}" Width="150">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="10,0"/><Setter Property="Foreground" Value="{StaticResource PrimaryButtonBrush}"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="{DynamicResource Str_Common_Customer}" Binding="{Binding Customer.FullName}" Width="160"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Common_PlateShort}" Binding="{Binding RegisteredLicensePlate}" Width="120"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColMonths}" Binding="{Binding DurationMonths}" Width="80"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColFee}" Binding="{Binding MonthlyPrice, StringFormat={}{0:N0} đ}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColExpiry}" Binding="{Binding EndDate, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColRegisteredAt}" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy}}" Width="110"/>

                                    <!-- Trạng thái thẻ -->
                                    <DataGridTemplateColumn Header="{DynamicResource Str_Customers_ColCardStatus}" Width="135">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActiveValid}" Value="True">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActiveValid}" Value="True">
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Thao tác trên từng dòng vé -->
                                    <DataGridTemplateColumn Header="{DynamicResource Str_Common_Actions}" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="{DynamicResource Str_Customers_CancelPass}"
                                                            ToolTip="{DynamicResource Str_Customers_CancelPassTip}"
                                                            Command="{Binding DataContext.CancelTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,2" Height="26" Margin="0,0,6,0"
                                                            Background="#FEE2E2" Foreground="#B91C1C"
                                                            BorderBrush="#FCA5A5" BorderThickness="1"
                                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <Button Command="{Binding DataContext.ToggleTicketCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,2" Height="26"
                                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="{DynamicResource Str_Customers_Lock}"/>
                                                                <Setter Property="Background" Value="#FEF3C7"/>
                                                                <Setter Property="Foreground" Value="#D97706"/>
                                                                <Setter Property="BorderBrush" Value="#FCD34D"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Suspended">
                                                                        <Setter Property="Content" Value="{DynamicResource Str_Customers_Unlock}"/>
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                        <Setter Property="Content" Value="{DynamicResource Str_Customers_Reopen}"/>
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                        <Setter Property="Foreground" Value="#15803D"/>
                                                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 4: DANH SÁCH CẤM (BLACKLIST) -->
                <TabItem Header="{DynamicResource Str_Customers_TabBlacklist}" FontSize="13" FontWeight="Bold" Foreground="#DC2626">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Customers_BlacklistTitle}" FontSize="13.5" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                                    <Border Background="#FEE2E2" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B91C1C"><Run Text="{Binding BlacklistedCount, Mode=OneWay}"/><Run Text="{DynamicResource Str_Customers_BannedCountSuffix}"/></TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{DynamicResource Str_Customers_AddToBlacklist}" Command="{Binding AddBlacklistCommand}" Padding="12,6" Background="#EF4444" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Thanh Tìm Kiếm Blacklist -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="360"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" Height="34">
                                        <Grid>
                                            <TextBlock Text="{DynamicResource Str_Customers_BlacklistSearch}" VerticalAlignment="Center" Margin="10,0" Foreground="{StaticResource TextDimBrush}" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BlacklistSearchKeyword}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BlacklistSearchKeyword}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding BlacklistSearchKeyword, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" Padding="8,0" CharacterCasing="Upper"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bảng Danh Sách Xe Bị Cấm -->
                            <DataGrid ItemsSource="{Binding BlacklistVehicles}"
                                      SelectedItem="{Binding SelectedBlacklist}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      RowHeight="38"
                                      MaxHeight="450"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                                      Background="Transparent"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource DividerBrush}"
                                      RowHeaderWidth="0"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single">

                                <DataGrid.Columns>
                                    <!-- Biển số xe -->
                                    <DataGridTextColumn Header="{DynamicResource Str_Common_Plate}" Binding="{Binding LicensePlate}" Width="130">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                                <Setter Property="Foreground" Value="#DC2626"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Lý do cấm -->
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColBanReason}" Binding="{Binding Reason}" Width="250">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Chủ xe liên quan -->
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColOwnerOptional}" Binding="{Binding Customer.FullName, TargetNullValue='—'}" Width="160">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Thời gian lập lệnh cấm -->
                                    <DataGridTextColumn Header="{DynamicResource Str_Customers_ColBannedAt}" Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Ghi chú chi tiết -->
                                    <DataGridTextColumn Header="{DynamicResource Str_Common_Notes}" Binding="{Binding Notes, TargetNullValue='--'}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="Margin" Value="10,0"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- Trạng thái cấm -->
                                    <DataGridTemplateColumn Header="{DynamicResource Str_Common_Status}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Customers_Banned}"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Text" Value="{DynamicResource Str_Customers_Unbanned}"/>
                                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Cột Thao Tác (Gỡ cấm / Cấm lại & Xóa) -->
                                    <DataGridTemplateColumn Header="{DynamicResource Str_Common_Actions}" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.ToggleBlacklistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,2" Height="26" Margin="0,0,6,0"
                                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="{DynamicResource Str_Customers_Unban}"/>
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Content" Value="{DynamicResource Str_Customers_Reban}"/>
                                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <Button Content="{DynamicResource Str_Common_Delete}"
                                                            ToolTip="{DynamicResource Str_Customers_RemoveBlacklistTip}"
                                                            Command="{Binding DataContext.DeleteBlacklistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="6,2" Height="26"
                                                            Background="#F3F4F6" Foreground="#4B5563"
                                                            BorderBrush="#D1D5DB" BorderThickness="1"
                                                            FontSize="11" FontWeight="SemiBold" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
