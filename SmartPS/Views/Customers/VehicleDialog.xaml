<Window x:Class="SmartPS.Views.Customers.VehicleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Customers_AddVehicle}" Height="300" Width="400" WindowStartupLocation="CenterScreen" Background="{StaticResource CardBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgPlate}" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBox x:Name="txtPlate" Text="{Binding LicensePlate, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgVehicleType}" Grid.Row="1" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboType" ItemsSource="{Binding VehicleTypes}" SelectedItem="{Binding SelectedVehicleType, Mode=TwoWay}" DisplayMemberPath="TypeName" Grid.Row="1" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="{DynamicResource Str_Customers_DlgOwner}" Grid.Row="2" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboCustomer" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" DisplayMemberPath="FullName" Grid.Row="2" Margin="100,0,0,10" Height="25" IsEditable="True" IsTextSearchEnabled="True"/>
        
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Common_Cancel}" MinWidth="85" Height="32" Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Common_Save}" MinWidth="85" Height="32" Margin="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
