<Window x:Class="SmartPS.Views.Customers.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Khách Hàng" Height="400" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Họ và Tên:" Grid.Row="0" Margin="0,5,0,0"/>
        <TextBox x:Name="txtFullName" Grid.Row="0" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="Số ĐT:" Grid.Row="1" Margin="0,5,0,0"/>
        <TextBox x:Name="txtPhoneNumber" Grid.Row="1" Margin="100,0,0,10" Height="25"/>
        
        <TextBlock Text="Hộ Gia Đình:" Grid.Row="2" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboHousehold" Grid.Row="2" Margin="100,0,0,10" Height="25" IsEditable="True" IsTextSearchEnabled="True"/>
        
        <StackPanel x:Name="panelVehicle" Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Đăng Ký Phương Tiện (Không bắt buộc)" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Biển Số:" Grid.Row="0" Margin="0,5,0,0"/>
                <TextBox x:Name="txtPlate" Grid.Row="0" Margin="100,0,0,10" Height="25"/>
                
                <TextBlock Text="Loại Xe:" Grid.Row="1" Margin="0,5,0,0"/>
                <ComboBox x:Name="cboType" Grid.Row="1" Margin="100,0,0,10" Height="25" SelectedIndex="1">
                    <ComboBoxItem Content="Xe Đạp/Điện"/>
                    <ComboBoxItem Content="Xe Máy"/>
                    <ComboBoxItem Content="Xe Ô tô"/>
                </ComboBox>
            </Grid>
        </StackPanel>
        
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy" Width="80" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Lưu" Width="80" Height="30" Click="BtnSave_Click" Background="#2563EB" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
