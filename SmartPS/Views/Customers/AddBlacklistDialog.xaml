<Window x:Class="SmartPS.Views.Customers.AddBlacklistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Xe Vào Danh Sách Cấm" Height="360" Width="440" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Biển Số Xe (*):" Grid.Row="0" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <TextBox x:Name="txtPlate" Grid.Row="0" Margin="120,0,0,12" Height="30" CharacterCasing="Upper" FontSize="14" FontWeight="Bold" Padding="6,2" VerticalContentAlignment="Center"/>

        <TextBlock Text="Lý Do Cấm (*):" Grid.Row="1" Margin="0,5,0,0" FontWeight="SemiBold"/>
        <ComboBox x:Name="cboReason" Grid.Row="1" Margin="120,0,0,12" Height="30" SelectedIndex="0" IsEditable="True">
            <ComboBoxItem Content="Nợ / Quỵt cước gửi xe nhiều lần"/>
            <ComboBoxItem Content="Cố tình va chạm, làm hỏng Barrier / Tài sản"/>
            <ComboBoxItem Content="Xe vi phạm an ninh trật tự / Yêu cầu từ BQL"/>
            <ComboBoxItem Content="Nghi vấn xe gian / Trộm cắp (Cảnh sát yêu cầu giữ)"/>
            <ComboBoxItem Content="Đỗ sai quy định, cản trở lối thoát hiểm"/>
            <ComboBoxItem Content="Khác (Ghi rõ ở ghi chú)"/>
        </ComboBox>

        <TextBlock Text="Chủ Xe (Tùy chọn):" Grid.Row="2" Margin="0,5,0,0"/>
        <ComboBox x:Name="cboCustomer" Grid.Row="2" Margin="120,0,0,12" Height="30" IsEditable="True" IsTextSearchEnabled="True"/>

        <TextBlock Text="Ghi Chú Chi Tiết:" Grid.Row="3" Margin="0,5,0,0"/>
        <TextBox x:Name="txtNotes" Grid.Row="3" Margin="120,0,0,12" Height="55" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Hủy" Width="80" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Lưu Cấm" Width="100" Height="32" Click="BtnSave_Click" Background="#EF4444" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
