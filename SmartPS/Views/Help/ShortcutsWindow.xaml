<Window x:Class="SmartPS.Views.Help.ShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_Shortcuts_WindowTitle}"
        Width="560" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCloseExecuted"/>
    </Window.CommandBindings>

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource Str_Shortcuts_Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource Str_Shortcuts_Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,16,12">
                <ItemsControl x:Name="GroupsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrandBrush}" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{StaticResource SurfaceStrongBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                                            BorderThickness="1,1,1,2" CornerRadius="4" Padding="8,2">
                                                        <TextBlock Text="{Binding Keys}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12.5" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenGuideClick">
                <TextBlock Text="{DynamicResource Str_Shortcuts_OpenGuide}" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Btn_Close}"
                    IsCancel="True" IsDefault="True" Click="OnCloseClick"/>
        </DockPanel>
    </Grid>
</Window>
