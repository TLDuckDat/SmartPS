<UserControl x:Class="SmartPS.Views.GateControl.GateControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartPS.ViewModels.GateControl"
             mc:Ignorable="d"
             d:DesignHeight="950" d:DesignWidth="1200">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header & Banner -->
                <RowDefinition Height="Auto"/> <!-- Thanh Chế Độ Tự Động (Smart Auto Gate) -->
                <RowDefinition Height="Auto"/> <!-- 2 Làn Vào / Ra -->
                <RowDefinition Height="Auto"/> <!-- Bảng Xe Đang Trong Bãi -->
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- ROW 0: HEADER PHÂN HỆ KIỂM SOÁT CỔNG           -->
            <!-- ============================================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="20,14"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Menu_GateControl}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF2F2"/>
                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOcrEngineAvailable}" Value="True">
                                                <Setter Property="Background" Value="#EFF6FF"/>
                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DC2626"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOcrEngineAvailable}" Value="True">
                                                        <Setter Property="Background" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding OcrEngineStatusText}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOcrEngineAvailable}" Value="True">
                                                        <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource Str_GateUi_Subtitle}"
                                   FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Thống kê nhanh & Làm mới -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F1F5F9" CornerRadius="4" Padding="12,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_GateUi_ParkedNow}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding ActiveSessions.Count}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryButtonBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="32" Padding="10,0"
                                Command="{Binding RefreshActiveSessionsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{DynamicResource Str_GateUi_RefreshLot}" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- ROW 1: THANH ĐIỀU KHIỂN TỰ ĐỘNG HÓA (AUTO GATE) -->
            <!-- ============================================== -->
            <Border Grid.Row="1"
                    Background="#0F172A"
                    CornerRadius="6"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nhóm 1: Công tắc Bật/Tắt Tự Động Hóa -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Toggle Chế độ Tự Động -->
                        <Button Command="{Binding ToggleAutoModeCommand}"
                                Cursor="Hand" BorderThickness="0" Background="Transparent">
                            <Border CornerRadius="4" Padding="12,7"
                                    Background="{Binding AutoModeBadgeBackground}"
                                    BorderBrush="{Binding AutoModeBadgeBorder}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AutoModeStatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding AutoModeBadgeForeground}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- Tùy chọn: Tự động cho ra cả xe vãng lai -->
                        <CheckBox Content="{DynamicResource Str_GateUi_AutoExitVisitors}"
                                  IsChecked="{Binding IsAutoCheckoutAllVehicles}"
                                  Foreground="#CBD5E1" FontSize="12"
                                  VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <!-- Nhóm 2: Các nút kích hoạt Giám sát & Mô phỏng tự động -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Nút Bật/Tắt Giám sát Thư mục Camera -->
                        <Button Command="{Binding ToggleCameraWatcherCommand}"
                                Cursor="Hand" Height="34" Padding="12,0" Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="{DynamicResource Str_GateUi_CameraWatchTip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CameraWatcherStatusText}" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Chạy Mô Phỏng Tự Động (Auto Demo) -->
                        <Button Command="{Binding RunAutoSimulationCommand}"
                                Cursor="Hand" Height="34" Padding="14,0"
                                Background="#1D4ED8" BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2563EB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎬" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_GateUi_RunDemo}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- ROW 2: HAI LÀN XE (LÀN VÀO & LÀN RA SONG SONG)  -->
            <!-- ============================================== -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- CỘT TRÁI: LÀN XE VÀO (IN GATE)             -->
                <!-- ========================================== -->
                <Border Grid.Column="0"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="6"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel>
                        <!-- Header Làn Vào -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1D4ED8" Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_InLaneTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Str_GateUi_InLaneSub}"
                                           FontSize="11" Foreground="#16A34A" FontWeight="SemiBold" Margin="18,2,0,0"/>
                            </StackPanel>

                            <!-- Badge Trạng thái Barrier Vào -->
                            <Border Grid.Column="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBarrierInOpen}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Str_GateUi_BarrierClosed}"/>
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBarrierInOpen}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Str_GateUi_BarrierOpen}"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Khung Camera / Ảnh Xe Vào -->
                        <Border Height="230" Background="#0F172A" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,12">
                            <Grid>
                                <!-- Ảnh xe vào -->
                                <Image Source="{Binding InAnnotatedImagePath, Converter={StaticResource ImagePathConverter}}"
                                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InAnnotatedImagePath}" Value="{x:Null}">
                                                    <Setter Property="Source" Value="{Binding InImagePath, Converter={StaticResource ImagePathConverter}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Placeholder khi chưa có ảnh -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding InImagePath}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding InAnnotatedImagePath}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="📹" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_InCameraTitle}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_InCameraHint}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Overlay thông số OCR bên góc trên -->
                                <Border Background="#CC0F172A" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Str_GateUi_Ocr}" FontSize="10.5" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding InConfidenceFormatted}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_Time}" FontSize="10.5" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding InProcessingTimeMs, StringFormat={}{0:0.0}ms}" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thẻ Nhận Diện Biển Số Làn Vào -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Crop biển số xe phóng to -->
                                <Border Grid.Column="0" Height="68" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding InCropImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_PlateRegion}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InCropImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Biển số xe & Phân loại -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_GateUi_InPlateTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBox Text="{Binding InPlateText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                                             Background="#FEF08A" BorderBrush="#FACC15" BorderThickness="2"
                                             Height="38" Padding="10,2" Margin="0,4,0,4"
                                             VerticalContentAlignment="Center" CharacterCasing="Upper"/>
                                    <TextBlock Text="{Binding InCustomerBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chi tiết ghi nhận lưu trữ phiên vào gần nhất -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastInTimeFormatted}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource Str_GateUi_InRecorded}" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                    <TextBlock FontSize="11.5" Foreground="#1E293B" Margin="0,2,0,0">
                                        <Run Text="{DynamicResource Str_GateUi_InTime}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding LastInTimeFormatted, FallbackValue='--:--'}" FontWeight="Bold" Foreground="#047857"/>
                                        <Run Text="{DynamicResource Str_GateUi_InTicket}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding LastInTicketCode, FallbackValue='--'}" FontWeight="SemiBold"/>
                                        <Run Text="{DynamicResource Str_GateUi_InSlot}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding LastInSlotCode, FallbackValue='—'}" FontWeight="Bold" Foreground="#0F766E"/>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_GateUi_DbSafe}" FontSize="10.5" FontWeight="Bold" Foreground="#15803D"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thông Tin Phân Luồng & Ô Đỗ -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Loại phương tiện -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Str_GateUi_VehicleType}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding VehicleTypes}"
                                          SelectedItem="{Binding InSelectedVehicleType}"
                                          DisplayMemberPath="TypeName"
                                          Height="34" FontSize="12.5"/>
                            </StackPanel>

                            <!-- Ô đỗ đề xuất -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource Str_GateUi_SuggestedSlot}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Border Height="34" Background="#F1F5F9" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,0">
                                    <TextBlock Text="{Binding InSuggestedSlotCode}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Hàng Nút Thao Tác Làn Vào -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding SelectInImageCommand}"
                                    ToolTip="{DynamicResource Str_GateUi_PickImageInTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_PickImage}" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding QuickTestInCommand}"
                                    ToolTip="{DynamicResource Str_GateUi_SampleInTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_SampleIn}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36" Margin="0"
                                    Command="{Binding ConfirmCheckInCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_ConfirmIn}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Thông báo trạng thái làn vào -->
                        <TextBlock Text="{Binding InStatusMessage}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" Margin="2,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ========================================== -->
                <!-- CỘT PHẢI: LÀN XE RA (OUT GATE)             -->
                <!-- ========================================== -->
                <Border Grid.Column="2"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="6"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <StackPanel>
                        <!-- Header Làn Ra -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#16A34A" Width="10" Height="10" CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_OutLaneTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Str_GateUi_OutLaneSub}"
                                           FontSize="11" Foreground="#16A34A" FontWeight="SemiBold" Margin="18,2,0,0"/>
                            </StackPanel>

                            <!-- Badge Trạng thái Barrier Ra -->
                            <Border Grid.Column="1" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEE2E2"/>
                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBarrierOutOpen}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Str_GateUi_BarrierClosed}"/>
                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBarrierOutOpen}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Str_GateUi_BarrierOpen}"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Khung Camera / Ảnh Xe Ra -->
                        <Border Height="230" Background="#0F172A" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,12">
                            <Grid>
                                <!-- Ảnh xe ra -->
                                <Image Source="{Binding OutAnnotatedImagePath, Converter={StaticResource ImagePathConverter}}"
                                       Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OutAnnotatedImagePath}" Value="{x:Null}">
                                                    <Setter Property="Source" Value="{Binding OutImagePath, Converter={StaticResource ImagePathConverter}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Placeholder khi chưa có ảnh -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding OutImagePath}" Value="{x:Null}"/>
                                                        <Condition Binding="{Binding OutAnnotatedImagePath}" Value="{x:Null}"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="📹" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_OutCameraTitle}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_GateUi_OutCameraHint}" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Overlay thông số OCR bên góc trên -->
                                <Border Background="#CC0F172A" CornerRadius="4" Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Str_GateUi_Ocr}" FontSize="10.5" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding OutConfidenceFormatted}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_Time}" FontSize="10.5" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding OutProcessingTimeMs, StringFormat={}{0:0.0}ms}" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Thẻ Nhận Diện Biển Số Làn Ra & So Khớp -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Crop biển số xe ra -->
                                <Border Grid.Column="0" Height="68" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding OutCropImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_PlateRegion}" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OutCropImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Biển số xe & Chỉ báo so khớp -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_GateUi_OutPlateTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBox Text="{Binding OutPlateText, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                                             Background="#FEF08A" BorderBrush="#FACC15" BorderThickness="2"
                                             Height="38" Padding="10,2" Margin="0,4,0,4"
                                             VerticalContentAlignment="Center" CharacterCasing="Upper"/>
                                    <TextBlock Text="{Binding PlateMatchStatusText}" FontSize="11.5" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding PlateMatchBadgeColor}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Thẻ Đối Chiếu Ảnh Vào vs Ra & Cước Phí -->
                        <Border Background="#F1F5F9" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ảnh xe lúc vào để đối soát -->
                                <Border Grid.Column="0" Height="68" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,12,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding MatchedSession.CheckInImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_EntryPhoto}" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchedSession.CheckInImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Thời gian gửi & Phương thức thanh toán -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                        <TextBlock Text="{DynamicResource Str_GateUi_Duration}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DurationFormatted}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Str_GateUi_Payment}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AvailablePaymentMethods}"
                                                  SelectedItem="{Binding SelectedPaymentMethod}"
                                                  Height="28" Width="100" FontSize="11.5"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Tổng tiền cước -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource Str_GateUi_TotalFee}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding CalculatedFeeFormatted}" FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <!-- Chi tiết cước phí -->
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding FeeDetails}" FontSize="11" Foreground="#059669" FontStyle="Italic" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Hàng Nút Thao Tác Làn Ra -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding SelectOutImageCommand}"
                                    ToolTip="{DynamicResource Str_GateUi_PickImageOutTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_PickImage}" FontSize="12"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="10,0" Margin="0,0,6,0"
                                    Command="{Binding QuickTestOutCommand}"
                                    ToolTip="{DynamicResource Str_GateUi_SampleOutTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_SampleOut}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36" Margin="0"
                                    Background="#16A34A"
                                    Command="{Binding ConfirmCheckOutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Str_GateUi_ChargeAndOpen}" FontSize="12" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Thông báo trạng thái làn ra -->
                        <TextBlock Text="{Binding OutStatusMessage}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" Margin="2,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- ROW 3: DANH SÁCH CÁC XE ĐANG TRONG BÃI (LIVE)  -->
            <!-- ============================================== -->
            <Border Grid.Row="3"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="18,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_GateUi_ParkedListTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding ActiveSessions.Count, Mode=OneWay}"/><Run Text="{DynamicResource Str_Unit_VehicleSuffix}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_GateUi_ParkedListHint}"
                                   FontSize="11.5" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- DataGrid Danh sách xe đang gửi -->
                    <DataGrid ItemsSource="{Binding ActiveSessions}"
                              SelectedItem="{Binding SelectedActiveSession}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeight="36"
                              MaxHeight="260"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Mã vé -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColTicket}" Binding="{Binding TicketCode}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Biển số xe -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColPlate}" Binding="{Binding LicensePlate}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Loại phương tiện -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColVehicleType}" Binding="{Binding VehicleType.TypeName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Vị trí ô đỗ -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColSlot}" Binding="{Binding Slot.SlotCode}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Thời gian vào (chính xác theo giờ máy trạm địa phương) -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColCheckIn}" Binding="{Binding CheckInTimeLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Thời lượng đã gửi trong bãi -->
                            <DataGridTextColumn Header="{DynamicResource Str_GateUi_ColDuration}" Binding="{Binding DurationDisplay}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0284C7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Phân loại khách hàng -->
                            <DataGridTemplateColumn Header="{DynamicResource Str_GateUi_ColCustomer}" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                                            <Border CornerRadius="3" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMonthlyPass}" Value="True">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CustomerType}" Value="Resident">
                                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{DynamicResource Str_GateUi_Visitor}"/>
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMonthlyPass}" Value="True">
                                                                    <Setter Property="Text" Value="{DynamicResource Str_GateUi_MonthlyPass}"/>
                                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CustomerType}" Value="Resident">
                                                                    <Setter Property="Text" Value="{DynamicResource Str_GateUi_Resident}"/>
                                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <TextBlock Text="{Binding Customer.FullName}" Margin="8,0,0,0"
                                                       FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

    <!-- ======================================================== -->
    <!-- MODAL POPUP: THANH TOÁN VIETQR XUẤT BÃI (PAYMENT MODAL)   -->
    <!-- ======================================================== -->
    <Grid Background="#99000000" Focusable="True">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVietQrModalOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Border Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="16"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1"
                Width="940"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="30,26,30,26">
            <Border.Effect>
                <DropShadowEffect BlurRadius="35" ShadowDepth="8" Direction="270" Color="#000000" Opacity="0.32"/>
            </Border.Effect>

            <StackPanel>
                <!-- Modal Header -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="10" Padding="8,6" Margin="0,0,12,0">
                                <TextBlock Text="📱" FontSize="20"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_GateUi_QrTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Str_GateUi_QrHint}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Biển số xe nổi bật -->
                    <Border Grid.Column="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="0,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Xe: " FontSize="12.5" FontWeight="SemiBold" Foreground="#92400E"/>
                            <TextBlock Text="{Binding MatchedSession.LicensePlate}" FontSize="17" FontWeight="Bold" Foreground="#78350F"/>
                        </StackPanel>
                    </Border>

                    <!-- Nút Hủy / Đóng -->
                    <Button Grid.Column="2" Command="{Binding CancelVietQrPaymentCommand}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                    </Button>
                </Grid>

                <!-- Modal Body: 2 Cột rộng rãi (Mã QR & Thông tin thanh toán / Thành công) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cột Trái: Thẻ mã QR Code lớn, sắc nét -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0"
                            BorderThickness="1" CornerRadius="14" Padding="18,16">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Badge mạng thanh toán -->
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12,5" Margin="0,0,0,12" HorizontalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_GateUi_QrNetwork}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>

                            <Border Width="270" Height="270" Background="White" CornerRadius="10"
                                    BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True" Padding="8">
                                <Grid>
                                    <Image Source="{Binding VietQrImageSource}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    
                                    <!-- Indicator đang nạp QR -->
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVietQrLoading}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="⏳" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_QrCreating}" FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Str_GateUi_QrHint}" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280"/>
                        </StackPanel>
                    </Border>

                    <!-- Cột Phải: Giao diện 2 trạng thái (Đang chờ / Thành công) -->
                    <Grid Grid.Column="2">
                        <!-- TRẠNG THÁI 1: ĐANG CHỜ THANH TOÁN -->
                        <Border Background="{StaticResource AppBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="18,16"
                                Visibility="{Binding IsVietQrPaidSuccess, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Thẻ Số tiền thanh toán (Hero) -->
                                <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="10" Padding="18,12" Margin="0,0,0,14">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Str_GateUi_QrAmount}" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                            <TextBlock Text="{Binding VietQrAmountFormatted}" FontSize="32" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>
                                        <Border Background="#DCFCE7" CornerRadius="6" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="VND" FontSize="13" FontWeight="Bold" Foreground="#15803D"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Thẻ Thông tin ngân hàng & chuyển khoản chi tiết -->
                                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <!-- Dòng 1: Ngân hàng -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_GateUi_QrBank}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VietQrBankName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Dòng 2: Số tài khoản + Nút Copy -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_GateUi_QrAccount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding VietQrAccountNumber}" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Command="{Binding CopyAccountNumberCommand}"
                                                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,3" Cursor="Hand">
                                                    <TextBlock Text="{DynamicResource Str_GateUi_QrCopy}" FontSize="11" Foreground="#334155"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Dòng 3: Chủ tài khoản -->
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_GateUi_QrAccountName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VietQrAccountName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Border Height="1" Background="#F1F5F9" Margin="0,2,0,10"/>

                                        <!-- Dòng 4: Nội dung chuyển khoản + Nút Copy -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="{DynamicResource Str_GateUi_QrContent}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding VietQrDescription}" FontSize="13.5" FontWeight="Bold" FontFamily="Consolas" Foreground="#1D4ED8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Command="{Binding CopyDescriptionCommand}"
                                                        Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Padding="8,3" Cursor="Hand">
                                                    <TextBlock Text="{DynamicResource Str_GateUi_QrCopy}" FontSize="11" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Badge Trạng Thái Chờ -->
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding VietQrStatusText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_QrWaitingScanDetail}" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- TRẠNG THÁI 2: THANH TOÁN THÀNH CÔNG (SUCCESS VIEW) -->
                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1.5" CornerRadius="14" Padding="28,24"
                                Visibility="{Binding IsVietQrPaidSuccess, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Vòng tròn tích xanh lớn -->
                                <Border Width="64" Height="64" CornerRadius="32" Background="#22C55E" HorizontalAlignment="Center" Margin="0,0,0,14">
                                    <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{DynamicResource Str_GateUi_QrSuccessTitle}" FontSize="22" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_GateUi_QrSuccessDesc}" FontSize="13" Foreground="#166534"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,18"/>

                                <!-- Hộp tóm tắt đối soát -->
                                <Border Width="400" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Biển số xe:" FontSize="13" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding MatchedSession.LicensePlate}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Số tiền đã thu:" FontSize="13" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding VietQrAmountFormatted}" FontSize="20" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Mã tham chiếu:" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                            <TextBlock Text="{Binding VietQrTransactionReference}" FontSize="12" FontFamily="Consolas" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Nút to Hoàn tất & Cho xe tiếp theo -->
                                <Button Command="{Binding CompletePaymentCommand}"
                                        Background="#16A34A" Foreground="White" BorderThickness="0"
                                        Height="48" Width="380" Cursor="Hand" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{DynamicResource Str_GateUi_QrCompleteBtn}" FontSize="15" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Modal Footer: Chỉ hiển thị khi đang chờ (Chưa thành công) -->
                <Grid Visibility="{Binding IsVietQrPaidSuccess, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_GateUi_QrAutoOpen}"
                               FontSize="11.5" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic" VerticalAlignment="Center"/>

                    <!-- Nút Xác nhận đã nhận tiền -->
                    <Button Grid.Column="1" Command="{Binding ConfirmPaymentReceivedCommand}"
                            Background="#16A34A" Foreground="White" BorderThickness="0"
                            Height="40" Padding="16,0" Margin="0,0,10,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_GateUi_QrConfirmReceived}" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2" Command="{Binding RefreshVietQrStatusCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Height="40" Padding="14,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_GateUi_QrCheck}" FontSize="12.5" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3" Command="{Binding CancelVietQrPaymentCommand}"
                            Background="#F1F5F9" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1"
                            Height="40" Padding="18,0" Cursor="Hand">
                        <TextBlock Text="{DynamicResource Str_GateUi_QrCancel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Grid>
</UserControl>