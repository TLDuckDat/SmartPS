<UserControl x:Class="SmartPS.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Chấm trạng thái: xanh khi Tag = True, đỏ khi Tag = False -->
        <Style x:Key="StatusDotStyle" TargetType="Border">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#16A34A"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Chấm trạng thái cảnh báo: vàng khi Tag = False (chạy được nhưng chưa cấu hình đầy đủ) -->
        <Style x:Key="StatusWarnDotStyle" TargetType="Border" BasedOn="{StaticResource StatusDotStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
        </Style>

        <Style x:Key="StatusTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="StatusDetailStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">
            <!-- Header Phân Hệ -->
            <Border Style="{StaticResource SettingsCardStyle}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Menu_Settings}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_SetUi_Subtitle}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" Margin="16,0,0,0"
                            Command="{Binding RefreshCommand}">
                        <TextBlock Text="{DynamicResource Str_SetUi_Recheck}" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 1. Tham số vận hành -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_SetUi_ParamsTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource Str_SetUi_AuditNote}" FontSize="12" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Str_SetUi_Overstay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" MaxLength="3"
                                     Text="{Binding OverstayThresholdHours, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanManage}"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding OverstayRangeHint, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_SetUi_OverstayHint}"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Str_SetUi_MaxVehicles}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" MaxLength="2"
                                     Text="{Binding MaxVehiclesPerHousehold, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanManage}"/>
                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0" TextWrapping="Wrap">
                                <Run Text="{Binding VehiclesRangeHint, Mode=OneWay}"/>
                                <Run Text="{DynamicResource Str_SetUi_MaxVehiclesHint}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_SetUi_Save}" HorizontalAlignment="Right" Margin="0,18,0,0"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </Border>

            <!-- 2. Tình trạng hệ thống -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_SetUi_StatusTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- CSDL -->
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusDotStyle}" Tag="{Binding IsDatabaseOnline}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatusTitleStyle}">
                                <Run Text="{DynamicResource Str_SetUi_Database}"/>
                                <Run Text="{Binding DatabaseSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding DatabaseDetail}" Style="{StaticResource StatusDetailStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- OCR -->
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusDotStyle}" Tag="{Binding IsOcrAvailable}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Top" Margin="16,0,0,0"
                                Command="{Binding TestOcrCommand}">
                            <TextBlock Text="{DynamicResource Str_SetUi_TestOcr}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatusTitleStyle}">
                                <Run Text="{DynamicResource Str_SetUi_Ocr}"/>
                                <Run Text="{Binding OcrSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding OcrDetail}" Style="{StaticResource StatusDetailStyle}"/>
                            <TextBlock Text="{Binding OcrTestResult}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Thanh toán -->
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusWarnDotStyle}" Tag="{Binding IsPaymentLive}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatusTitleStyle}">
                                <Run Text="{DynamicResource Str_SetUi_Payment}"/>
                                <Run Text="{Binding PaymentSummary, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PaymentDetail}" Style="{StaticResource StatusDetailStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Webhook -->
                    <DockPanel Margin="0,0,0,16">
                        <Border DockPanel.Dock="Left" Style="{StaticResource StatusDotStyle}" Tag="{Binding IsWebhookRunning}"/>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_SetUi_Webhook}" Style="{StaticResource StatusTitleStyle}"/>
                            <TextBlock Text="{Binding WebhookSummary}" Style="{StaticResource StatusDetailStyle}"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,4,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_SetUi_CaptureFolder}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,6"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaptureStoragePath}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_SetUi_Version}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
