<UserControl x:Class="SmartPS.Views.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">
            <!-- Header Phân Hệ -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="24,18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Menu_Overview}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Bảng điều khiển tổng hợp tình trạng hoạt động và giám sát lưu lượng bãi xe thông minh" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource IceBadgeBackgroundBrush}" BorderBrush="{StaticResource IceBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Phân hệ MVVM độc lập" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrandBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Khung Thông Tin Module Chuẩn Kiến Trúc -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Trung Tâm Điều Phối Bãi Xe SmartPS" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Phân hệ Tổng quan đã được cấu hình độc lập theo mô hình MVVM, sẵn sàng nạp dữ liệu từ các thực thể cơ sở dữ liệu khi tiến hành tích hợp nghiệp vụ."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CÁC THỰC THỂ CƠ SỞ DỮ LIỆU LIÊN QUAN:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="• ParkingZone: Khu vực đỗ xe (Khu A, Khu B...)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• ParkingSlot: Danh sách các vị trí ô đỗ thực tế trong bãi" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• ParkingSession: Lịch sử lượt xe vào / ra và trạng thái chiếm chỗ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• VehicleType: Các loại phương tiện cơ giới (Xe máy, Ô tô, Xe đạp điện...)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Giao diện sẽ được gắn kết trực tiếp với tầng Service và DbContext khi triển khai nghiệp vụ cụ thể cho phân hệ này."
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

