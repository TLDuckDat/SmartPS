<UserControl x:Class="SmartPS.Views.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1100">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">

            <!-- 1. Header Phân Hệ & Nút Làm Mới Dữ Liệu Thực Thể -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="24,16"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource Str_Menu_Overview}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="Bảng điều khiển tổng hợp tình trạng hoạt động và giám sát lưu lượng bãi xe thông minh theo thời gian thực" 
                                   FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Nút bấm Làm mới dữ liệu -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshCommand}"
                                Height="36" Padding="14,0"
                                Background="{StaticResource PrimaryButtonBrush}"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Cập Nhật Số Liệu" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Hàng Thẻ KPI Số Liệu Thực Tế (5 Cột) -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Xe đang trong bãi -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ĐANG TRONG BÃI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="🚗" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalParkedVehicles}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryButtonBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding TotalSlots, StringFormat='Sức chứa: {0} ô đỗ'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Ô đỗ còn trống -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Ô ĐỖ CÒN TRỐNG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="🅿" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding AvailableSlots}" FontSize="28" FontWeight="Bold" Foreground="#15803D" Margin="0,8,0,2"/>
                        <TextBlock Text="Sẵn sàng đón lượt mới" FontSize="11.5" Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Tỷ lệ lấp đầy -->
                <Border Grid.Column="4" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TỶ LỆ LẤP ĐẦY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="📈" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding OccupancyRateFormatted}" FontSize="28" FontWeight="Bold" Foreground="#0284C7" Margin="0,8,0,6"/>
                        <ProgressBar Value="{Binding OccupancyRate}" Maximum="100" Height="6" Background="#E2E8F0" Foreground="#0284C7" BorderThickness="0"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Lượt xe vào hôm nay -->
                <Border Grid.Column="6" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="LƯỢT VÀO HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="📥" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TodayCheckIns}" FontSize="28" FontWeight="Bold" Foreground="#D97706" Margin="0,8,0,2"/>
                        <TextBlock Text="{Binding TodayCheckOuts, StringFormat='Đã xuất bãi: {0} xe'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 5: Doanh thu hôm nay -->
                <Border Grid.Column="8" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DOANH THU HÔM NAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}"/>
                            <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{Binding TodayRevenueFormatted}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,8,0,2"/>
                        <TextBlock Text="Thực thu trong ngày" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Hàng Phân Bổ Phương Tiện & Đối Tượng Khách Hàng -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Thống kê theo Loại xe -->
                <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PHÂN BỔ THEO LOẠI XE ĐANG ĐỖ" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏍 Xe máy (Khu A):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MotorbikeParkedCount, StringFormat='{}{0} xe'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Background="{StaticResource DividerBrush}" Margin="0,8"/>
                        <Grid Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🚗 Ô tô con (Khu B):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CarParkedCount, StringFormat='{}{0} xe'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Thống kê theo Hạng thẻ khách hàng -->
                <Border Grid.Column="2" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel>
                        <TextBlock Text="PHÂN LOẠI ĐỐI TƯỢNG GỬI XE" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👑 Khách vé tháng (Cư dân/Cố định):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MonthlyParkedCount, StringFormat='{}{0} xe'}" FontSize="13" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right"/>
                        </Grid>
                        <Separator Background="{StaticResource DividerBrush}" Margin="0,8"/>
                        <Grid Margin="0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎫 Khách vãng lai (Lượt):" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RegularParkedCount, StringFormat='{}{0} xe'}" FontSize="13" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Bảng Các Lượt Hoạt Động Vào / Ra Mới Nhất -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="LỊCH SỬ HOẠT ĐỘNG CỔNG VÀO / RA GẦN NHẤT" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding RecentSessions.Count, StringFormat='Hiển thị {0} phiên mới nhất'}" FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Right"/>
                    </Grid>

                    <DataGrid ItemsSource="{Binding RecentSessions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeight="36"
                              MaxHeight="320"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                              Background="Transparent"
                              BorderThickness="1"
                              BorderBrush="{StaticResource DividerBrush}"
                              RowHeaderWidth="0"
                              HeadersVisibility="Column"
                              SelectionMode="Single">

                        <DataGrid.Columns>
                            <!-- Mã vé -->
                            <DataGridTextColumn Header="Mã Vé" Binding="{Binding TicketCode}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryButtonBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Biển số xe -->
                            <DataGridTextColumn Header="Biển Số Xe" Binding="{Binding LicensePlate}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Loại phương tiện -->
                            <DataGridTextColumn Header="Loại Xe" Binding="{Binding VehicleType.TypeName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Vị trí ô đỗ -->
                            <DataGridTextColumn Header="Ô Đỗ" Binding="{Binding Slot.SlotCode, FallbackValue='Tự do'}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Thời gian vào -->
                            <DataGridTextColumn Header="Thời Gian Vào" Binding="{Binding CheckInTimeLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Thời gian ra -->
                            <DataGridTextColumn Header="Thời Gian Ra" Binding="{Binding CheckOutTimeLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}, TargetNullValue='--:--:--'}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Cước phí -->
                            <DataGridTextColumn Header="Cước Phí" Binding="{Binding TotalFee, StringFormat={}{0:N0} đ}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="10,0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#7C3AED"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Trạng thái -->
                            <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="3" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Đang xử lý"/>
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Text" Value="🚗 Đang đỗ trong bãi"/>
                                                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Text" Value="✔ Đã xuất bãi"/>
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
