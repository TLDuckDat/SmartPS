<UserControl x:Class="SmartPS.Views.Common.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Name="RootControl">

    <UserControl.Resources>
        <!-- Style nút con mắt bật/tắt hiển thị mật khẩu -->
        <Style x:Key="EyeToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Khung viền ô nhập mật khẩu -->
    <Border x:Name="MainBorder"
            Background="{Binding InputBackground, ElementName=RootControl}"
            BorderBrush="{Binding InputBorderBrush, ElementName=RootControl}"
            BorderThickness="{Binding InputBorderThickness, ElementName=RootControl}"
            CornerRadius="{Binding InputCornerRadius, ElementName=RootControl}"
            Height="{Binding InputHeight, ElementName=RootControl}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Chế độ Ẩn Mật khẩu (PasswordBox chuẩn) -->
            <PasswordBox Grid.Column="0"
                         x:Name="MaskedPasswordBox"
                         Background="Transparent"
                         BorderThickness="0"
                         VerticalContentAlignment="Center"
                         Padding="10,0"
                         FontSize="{Binding InputFontSize, ElementName=RootControl}"
                         Foreground="{Binding InputForeground, ElementName=RootControl}"
                         PasswordChanged="MaskedPasswordBox_PasswordChanged"
                         GotFocus="InputControl_GotFocus"
                         LostFocus="InputControl_LostFocus"
                         KeyDown="InputControl_KeyDown"/>

            <!-- 2. Chế độ Hiện Mật khẩu (TextBox văn bản thường) -->
            <TextBox Grid.Column="0"
                     x:Name="UnmaskedTextBox"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalContentAlignment="Center"
                     Padding="10,0"
                     FontSize="{Binding InputFontSize, ElementName=RootControl}"
                     Foreground="{Binding InputForeground, ElementName=RootControl}"
                     Visibility="Collapsed"
                     TextChanged="UnmaskedTextBox_TextChanged"
                     GotFocus="InputControl_GotFocus"
                     LostFocus="InputControl_LostFocus"
                     KeyDown="InputControl_KeyDown"/>

            <!-- 3. Nút Con Mắt Bật/Tắt (Eye Toggle) -->
            <Button Grid.Column="1"
                    x:Name="EyeToggleButton"
                    Style="{StaticResource EyeToggleButtonStyle}"
                    Click="EyeToggleButton_Click"
                    ToolTip="{DynamicResource Str_Password_Show}">
                <Path x:Name="EyeIconPath"
                      Width="18" Height="18"
                      Stretch="Uniform"
                      Fill="#64748B"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
