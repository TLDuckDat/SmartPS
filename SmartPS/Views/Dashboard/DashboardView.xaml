<Window x:Class="SmartPS.Views.Dashboard.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Smart Parking System - Quản Trị Hệ Thống &amp; Tài Khoản"
        Height="760" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <!-- Cấu hình WindowChrome: Kéo mép Resize và di chuyển TitleBar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42"
                      ResizeBorderThickness="6"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Viền chính của ứng dụng phong cách Trắng & Băng -->
    <Border Background="{StaticResource AppBackgroundBrush}"
            CornerRadius="14"
            BorderBrush="{StaticResource WindowBorderBrush}"
            BorderThickness="1"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" Color="#64748B" Opacity="0.18" ShadowDepth="4"/>
        </Border.Effect>

        <!-- Grid chính của Dashboard -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <!-- Row 0: Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Header Dashboard -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: 4 Thẻ Thống Kê Tài Khoản -->
                <RowDefinition Height="*"/>
                <!-- Row 3: Danh Sách Tài Khoản (Trái) & Form Tạo Tài Khoản (Phải) -->
            </Grid.RowDefinitions>

            <!-- ============================================== -->
            <!-- ROW 0: TITLE BAR                               -->
            <!-- ============================================== -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Smart Parking System" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextBrandBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="|" FontSize="11" Foreground="{StaticResource AppBorderBrush}" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Quản Trị Hệ Thống &amp; Phân Quyền Người Dùng" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,5,8,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowControlBtnStyle}" Content="-" Click="MinimizeButton_Click" ToolTip="Thu nhỏ"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlBtnStyle}" Content="[ ]" Click="MaximizeButton_Click" ToolTip="Phóng to / Khôi phục"/>
                    <Button Style="{StaticResource CloseControlBtnStyle}" Content="X" Click="CloseButton_Click" ToolTip="Đóng"/>
                </StackPanel>
            </Grid>

            <!-- ============================================== -->
            <!-- ROW 1: HEADER & USER PROFILE                   -->
            <!-- ============================================== -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,1,0,1"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource IceBadgeBackgroundBrush}"
                                BorderBrush="{StaticResource IceBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="38" Height="38"
                                Margin="0,0,12,0">
                            <TextBlock Text="P" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Trung Tâm Quản Trị Tài Khoản &amp; Phân Quyền" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="Đang đăng nhập: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentUserFullName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrandBrush}"/>
                                <TextBlock Text=" (" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CurrentUserRole}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text=")" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Làm mới"
                                Height="36" Padding="14,0"
                                Margin="0,0,10,0"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Tải lại danh sách tài khoản"/>

                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Content="Đăng xuất"
                                Height="36" Padding="14,0"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Đăng xuất khỏi hệ thống"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================== -->
            <!-- ROW 2: 4 THẺ THỐNG KÊ TÀI KHOẢN (KPI)         -->
            <!-- ============================================== -->
            <Grid Grid.Row="2" Margin="14,14,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Tổng tài khoản -->
                <Border Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Tổng Tài Khoản" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalUsers}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Người dùng trong toàn hệ thống" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 2: Quản trị viên (Admin) -->
                <Border Grid.Column="1" Margin="4,0,4,0" Background="{StaticResource BannerGradientBrush}" CornerRadius="10" BorderBrush="{StaticResource IceBadgeBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Quản Trị Viên (Admin)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrandBrush}"/>
                        <TextBlock Text="{Binding AdminCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrandBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Toàn quyền quản trị bãi xe" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 3: Quản lý (Manager) -->
                <Border Grid.Column="2" Margin="4,0,4,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Quản Lý (Manager)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ManagerCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Điều hành &amp; Giám sát ca trực" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Border>

                <!-- KPI 4: Nhân viên trực ca (Staff / Operator) -->
                <Border Grid.Column="3" Margin="8,0,0,0" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Nhân Viên (Staff / Operator)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding StaffCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Trực bốt soát vé xe vào / ra" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============================================== -->
            <!-- ROW 3: DANH SÁCH USER (TRÁI) & TẠO USER (PHẢI) -->
            <!-- ============================================== -->
            <Grid Grid.Row="3" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <!-- Cột 1: Danh sách tài khoản (Tỷ lệ 1.35*) -->
                    <ColumnDefinition Width="1.35*" MinWidth="480"/>
                    <!-- Cột 2: Form tạo tài khoản (Tỷ lệ 1*) -->
                    <ColumnDefinition Width="1*" MinWidth="380"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- CỘT TRÁI: DANH SÁCH TÀI KHOẢN HIỆN CÓ     -->
                <!-- ========================================== -->
                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Header & Bộ lọc vai trò -->
                            <RowDefinition Height="*"/>
                            <!-- Bảng DataGrid danh sách -->
                        </Grid.RowDefinitions>

                        <!-- Header & Nút lọc vai trò -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Danh Sách Tài Khoản Người Dùng" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Quản lý thông tin phân quyền các thành viên" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>

                            <!-- Bộ lọc vai trò -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Tất cả" Height="30" Padding="10,0" Margin="0,0,4,0" FontSize="12" Command="{Binding FilterRoleCommand}" CommandParameter="Tất cả"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Admin" Height="30" Padding="10,0" Margin="0,0,4,0" FontSize="12" Command="{Binding FilterRoleCommand}" CommandParameter="Admin"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Manager" Height="30" Padding="10,0" Margin="0,0,4,0" FontSize="12" Command="{Binding FilterRoleCommand}" CommandParameter="Manager"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Nhân viên" Height="30" Padding="10,0" FontSize="12" Command="{Binding FilterRoleCommand}" CommandParameter="Nhân viên"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid Danh sách người dùng -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DisplayedUsers}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  RowHeight="38"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource AppBorderBrush}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single">

                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFC"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource IceBadgeBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã" Binding="{Binding UserId}" Width="50"/>
                                <DataGridTextColumn Header="Tên Đăng Nhập" Binding="{Binding Username}" Width="120"/>
                                <DataGridTextColumn Header="Họ Và Tên" Binding="{Binding FullName}" Width="160"/>
                                <DataGridTextColumn Header="Vai Trò" Binding="{Binding Role.RoleName}" Width="100"/>
                                <DataGridTemplateColumn Header="Trạng Thái" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                    Background="{Binding IsActive, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock Text="Đang hoạt động" FontSize="11" Foreground="#047857" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- ========================================== -->
                <!-- CỘT PHẢI: FORM TẠO TÀI KHOẢN MỚI          -->
                <!-- ========================================== -->
                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Background="{StaticResource CardBackgroundBrush}"
                        CornerRadius="10"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        Padding="20">

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Tiêu đề Form -->
                            <TextBlock Text="Tạo Tài Khoản Mới" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cấp tài khoản cho Admin, Manager hoặc Nhân viên" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,18"/>

                            <!-- Tên đăng nhập -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Tên đăng nhập" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="NewUsernameInput"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Họ và tên -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Họ và tên" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="NewFullNameInput"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         Text="{Binding NewFullName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Mật khẩu -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Mật khẩu (Tối thiểu 6 ký tự)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="NewPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Xác nhận mật khẩu -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Xác nhận mật khẩu" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="ConfirmPasswordInput" Style="{StaticResource ModernPasswordBoxStyle}"/>
                            </StackPanel>

                            <!-- Chọn vai trò -->
                            <StackPanel Margin="0,0,0,22">
                                <TextBlock Text="Vai trò (Role)" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding SelectedRole}"
                                          DisplayMemberPath="RoleName"
                                          Height="42"
                                          FontSize="13"
                                          VerticalContentAlignment="Center"
                                          Background="{StaticResource InputBackgroundBrush}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          BorderBrush="{StaticResource InputBorderBrush}"/>
                            </StackPanel>

                            <!-- Nút bấm tạo tài khoản -->
                            <Button x:Name="CreateUserButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="TẠO TÀI KHOẢN"
                                    Click="CreateUserButton_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
