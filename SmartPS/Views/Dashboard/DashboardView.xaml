<Window x:Class="SmartPS.Views.Dashboard.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmOverview="clr-namespace:SmartPS.ViewModels.Overview"
        xmlns:vOverview="clr-namespace:SmartPS.Views.Overview"
        xmlns:vmGate="clr-namespace:SmartPS.ViewModels.GateControl"
        xmlns:vGate="clr-namespace:SmartPS.Views.GateControl"
        xmlns:vmMap="clr-namespace:SmartPS.ViewModels.ParkingMap"
        xmlns:vMap="clr-namespace:SmartPS.Views.ParkingMap"
        xmlns:vmCust="clr-namespace:SmartPS.ViewModels.Customers"
        xmlns:vCust="clr-namespace:SmartPS.Views.Customers"
        xmlns:vmRep="clr-namespace:SmartPS.ViewModels.Reports"
        xmlns:vRep="clr-namespace:SmartPS.Views.Reports"
        xmlns:vmInc="clr-namespace:SmartPS.ViewModels.Incidents"
        xmlns:vInc="clr-namespace:SmartPS.Views.Incidents"
        xmlns:vmTx="clr-namespace:SmartPS.ViewModels.Transactions"
        xmlns:vTx="clr-namespace:SmartPS.Views.Transactions"
        xmlns:vmUser="clr-namespace:SmartPS.ViewModels.UserManagement"
        xmlns:vUser="clr-namespace:SmartPS.Views.UserManagement"
        xmlns:vmPrice="clr-namespace:SmartPS.ViewModels.Pricing"
        xmlns:vPrice="clr-namespace:SmartPS.Views.Pricing"
        xmlns:vmSet="clr-namespace:SmartPS.ViewModels.Settings"
        xmlns:vSet="clr-namespace:SmartPS.Views.Settings"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Dash_WindowTitle}"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <!-- Mapping ViewModels sang Views độc lập chuẩn MVVM -->
        <DataTemplate DataType="{x:Type vmOverview:OverviewViewModel}">
            <vOverview:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmGate:GateControlViewModel}">
            <vGate:GateControlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMap:ParkingMapViewModel}">
            <vMap:ParkingMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCust:CustomersViewModel}">
            <vCust:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmRep:ReportsViewModel}">
            <vRep:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInc:IncidentsViewModel}">
            <vInc:IncidentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTx:TransactionsViewModel}">
            <vTx:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUser:UserManagementViewModel}">
            <vUser:UserManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPrice:PricingViewModel}">
            <vPrice:PricingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSet:SettingsViewModel}">
            <vSet:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <!-- Layout Chính: Cột Trái (Sidebar 250px) + Cột Phải (Nội dung) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Cột 0: Sidebar điều hướng Midnight Slate -->
            <ColumnDefinition Width="250"/>
            <!-- Cột 1: Vùng nội dung chính -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================== -->
        <!-- CỘT 0: SIDEBAR ĐIỀU HƯỚNG TỐI GIẢN (SLATE DARK) -->
        <!-- ============================================== -->
        <Border Grid.Column="0"
                Background="#0F172A"
                BorderBrush="#1E293B"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Brand Header -->
                    <RowDefinition Height="*"/>    <!-- Danh sách Menu 10 Phân Hệ -->
                    <RowDefinition Height="Auto"/> <!-- Footer trạng thái CSDL -->
                </Grid.RowDefinitions>

                <!-- 1. BRAND LOGO & SYSTEM TITLE -->
                <Border Grid.Row="0" Padding="18,18,18,16" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Icon -->
                        <Border Width="38" Height="38" CornerRadius="8" Background="#1D4ED8" Margin="0,0,12,0">
                            <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-6 8h-2v4H9V7h4c1.66 0 3 1.34 3 3s-1.34 3-3 3zm0-2c.55 0 1-.45 1-1s-.45-1-1-1h-2v2h2z"
                                  Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Smart" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="PS" FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                            <TextBlock Text="Bãi Đỗ Xe Thông Minh" FontSize="10.5" Foreground="#94A3B8" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. DANH SÁCH 10 MỤC MENU THEO PHÂN QUYỀN -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,12">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Mục Menu đơn lẻ -->
                                <Border Margin="0,2" CornerRadius="6"
                                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="10,9"
                                            HorizontalContentAlignment="Stretch"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1E293B"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Thanh viền trái chỉ báo mục active -->
                                            <Border Grid.Column="0" HorizontalAlignment="Left" Width="3" Height="16" CornerRadius="2"
                                                    Background="#38BDF8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Vector Icon -->
                                            <Path Grid.Column="0"
                                                  Data="{Binding IconData}"
                                                  Width="15" Height="15"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Fill" Value="#38BDF8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>

                                            <!-- Tên Mục Menu (Đa ngôn ngữ thời gian thực) -->
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       FontSize="12.5"
                                                       FontWeight="Medium"
                                                       Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Id}" Value="Overview">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Overview}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="GateControl">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_GateControl}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="ParkingMap">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_ParkingMap}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Customers">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Customers}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Reports">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Reports}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Incidents">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Incidents}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Transactions">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Transactions}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="UserManagement">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_UserManagement}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Pricing">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Pricing}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Id}" Value="Settings">
                                                                <Setter Property="Text" Value="{DynamicResource Str_Menu_Settings}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 3. FOOTER TRẠNG THÁI CSDL & PHIÊN BẢN -->
                <Border Grid.Row="2" Padding="16,14" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Background="#0A0F1D">
                    <Grid>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="4" Background="#22C55E" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource Str_Nav_DbConnected}" FontSize="11" FontWeight="SemiBold" Foreground="#22C55E"/>
                            </StackPanel>
                            <TextBlock Text="SmartPS Pro • v1.0.0" FontSize="10.5" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- CỘT 1: VÙNG NỘI DUNG CHÍNH (TOPBAR + CONTENT)   -->
        <!-- ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Topbar điều hướng & User profile -->
                <RowDefinition Height="*"/>    <!-- Row 1: ContentControl hiển thị View con -->
            </Grid.RowDefinitions>

            <!-- ROW 0: TOPBAR HEADER -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tiêu đề phân hệ đang chọn -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{DynamicResource Str_Dash_HeaderTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Overview">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Overview}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="GateControl">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_GateControl}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="ParkingMap">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_ParkingMap}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Customers">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Customers}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Reports">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Reports}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Incidents">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Incidents}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Transactions">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Transactions}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="UserManagement">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_UserManagement}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Pricing">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Pricing}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedNavItem.Id}" Value="Settings">
                                            <Setter Property="Text" Value="{DynamicResource Str_Menu_Settings}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- User Profile & Language Switcher & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Bộ 3 Nút Đổi Ngôn Ngữ -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <Button Content="🇻🇳 VI" Command="{Binding SetLanguageCommand}" CommandParameter="vi-VN" Style="{StaticResource LangButtonStyle}" ToolTip="{DynamicResource Str_Lang_VI}"/>
                            <Button Content="🇬🇧 EN" Command="{Binding SetLanguageCommand}" CommandParameter="en-US" Style="{StaticResource LangButtonStyle}" ToolTip="{DynamicResource Str_Lang_EN}"/>
                            <Button Content="🇯🇵 JA" Command="{Binding SetLanguageCommand}" CommandParameter="ja-JP" Style="{StaticResource LangButtonStyle}" ToolTip="{DynamicResource Str_Lang_JA}"/>
                        </StackPanel>

                        <!-- Thông tin người dùng đăng nhập -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding CurrentUserFullName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{StaticResource IceBadgeBackgroundBrush}" BorderBrush="{StaticResource IceBadgeBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserRole, Converter={StaticResource RoleLocalizedConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrandBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Nút Làm Mới -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="34" Padding="12,0"
                                Margin="3,0"
                                Command="{Binding RefreshCommand}"
                                ToolTip="{DynamicResource Str_Tooltip_Refresh}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_Dash_Btn_Refresh}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Nút Đăng Xuất -->
                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                Height="34" Padding="12,0"
                                Margin="3,0"
                                Command="{Binding LogoutCommand}"
                                ToolTip="{DynamicResource Str_Tooltip_Logout}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.1 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Str_Dash_Btn_Logout}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ROW 1: NỘI DUNG PHÂN HỆ ĐƯỢC CHỌN (DYNAMIC CONTENT HOST) -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
