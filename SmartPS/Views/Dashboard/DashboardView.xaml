<Window x:Class="SmartPS.Views.Dashboard.DashboardView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmOverview="clr-namespace:SmartPS.ViewModels.Overview"
        xmlns:vOverview="clr-namespace:SmartPS.Views.Overview"
        xmlns:vmGate="clr-namespace:SmartPS.ViewModels.GateControl"
        xmlns:vGate="clr-namespace:SmartPS.Views.GateControl"
        xmlns:vmMap="clr-namespace:SmartPS.ViewModels.ParkingMap"
        xmlns:vMap="clr-namespace:SmartPS.Views.ParkingMap"
        xmlns:vmCust="clr-namespace:SmartPS.ViewModels.Customers"
        xmlns:vCust="clr-namespace:SmartPS.Views.Customers"
        xmlns:vmRep="clr-namespace:SmartPS.ViewModels.Reports"
        xmlns:vRep="clr-namespace:SmartPS.Views.Reports"
        xmlns:vmInc="clr-namespace:SmartPS.ViewModels.Incidents"
        xmlns:vInc="clr-namespace:SmartPS.Views.Incidents"
        xmlns:vmTx="clr-namespace:SmartPS.ViewModels.Transactions"
        xmlns:vTx="clr-namespace:SmartPS.Views.Transactions"
        xmlns:vmShifts="clr-namespace:SmartPS.ViewModels.Shifts"
        xmlns:vShifts="clr-namespace:SmartPS.Views.Shifts"
        xmlns:vmUser="clr-namespace:SmartPS.ViewModels.UserManagement"
        xmlns:vUser="clr-namespace:SmartPS.Views.UserManagement"
        xmlns:vmPrice="clr-namespace:SmartPS.ViewModels.Pricing"
        xmlns:vPrice="clr-namespace:SmartPS.Views.Pricing"
        xmlns:vmSet="clr-namespace:SmartPS.ViewModels.Settings"
        xmlns:vSet="clr-namespace:SmartPS.Views.Settings"
        xmlns:vmAudit="clr-namespace:SmartPS.ViewModels.Audit"
        xmlns:vAudit="clr-namespace:SmartPS.Views.Audit"
        xmlns:vmRolePerm="clr-namespace:SmartPS.ViewModels.RolePermissions"
        xmlns:vRolePerm="clr-namespace:SmartPS.Views.RolePermissions"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Dash_WindowTitle}"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        Background="{StaticResource AppBackgroundBrush}">

    <!-- Phím tắt toàn cục của cửa sổ chính -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowShortcutsCommand}"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="F4" Modifiers="Ctrl" Command="{Binding CloseTabCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding LogoutCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding OpenByShortcutCommand}" CommandParameter="9"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Mapping ViewModels sang Views độc lập chuẩn MVVM -->
        <DataTemplate DataType="{x:Type vmOverview:OverviewViewModel}">
            <vOverview:OverviewView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmGate:GateControlViewModel}">
            <vGate:GateControlView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMap:ParkingMapViewModel}">
            <vMap:ParkingMapView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCust:CustomersViewModel}">
            <vCust:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmRep:ReportsViewModel}">
            <vRep:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInc:IncidentsViewModel}">
            <vInc:IncidentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmTx:TransactionsViewModel}">
            <vTx:TransactionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmShifts:ShiftsViewModel}">
            <vShifts:ShiftsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmUser:UserManagementViewModel}">
            <vUser:UserManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmPrice:PricingViewModel}">
            <vPrice:PricingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmSet:SettingsViewModel}">
            <vSet:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmRolePerm:RolePermissionsViewModel}">
            <vRolePerm:RolePermissionsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmAudit:AuditLogViewModel}">
            <vAudit:AuditLogView/>
        </DataTemplate>

        <!-- Biểu tượng của mục menu (x:Shared=False: mỗi mục một bản riêng) -->
        <Path x:Key="NavMenuIcon" x:Shared="False"
              Data="{Binding IconData}" Width="14" Height="14" Stretch="Uniform"
              Fill="{StaticResource TextSecondaryBrush}"/>

        <!-- Mục menu của một phân hệ: ẩn khi không có quyền, hiện phím tắt Ctrl+n -->
        <Style x:Key="NavMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Header" Value="{Binding Title}"/>
            <Setter Property="Command" Value="{Binding OpenCommand}"/>
            <Setter Property="InputGestureText" Value="{Binding ShortcutText}"/>
            <Setter Property="Icon" Value="{StaticResource NavMenuIcon}"/>
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Biểu tượng trên thanh công cụ -->
        <Style x:Key="ToolbarIconStyle" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Nhãn chữ của nút hệ thống: ẩn khi cửa sổ hẹp (Tag="Compact"), chỉ còn icon + tooltip -->
        <Style x:Key="ToolLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="Compact">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ToolBar phẳng: không có tay kéo, không có nút tràn -->
        <Style x:Key="FlatToolBarStyle" TargetType="ToolBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút trên thanh công cụ: phẳng, bo góc, nền xám nhạt khi rê chuột -->
        <Style x:Key="FlatToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thẻ phẳng: thẻ đang chọn nền trắng liền với vùng nội dung -->
        <Style x:Key="FlatTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1,1,1,0"
                                CornerRadius="6,6,0,0" Padding="12,7,8,7" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatTabControlStyle" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource FlatTabItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Dải thẻ nền xám; thẻ đang chọn đè 1px lên viền vùng nội dung -->
                            <Border Background="{StaticResource AppBackgroundBrush}" Padding="10,8,10,0" Panel.ZIndex="1">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="0,0,0,-1"/>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút đóng (✕) trên thẻ -->
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <Path Width="8" Height="8" Stretch="Uniform" Fill="{StaticResource TextDimBrush}"
                                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ============================================================ -->
        <!-- 1. THANH TRÊN CÙNG: Menu (MenuStrip) + ToolBar (ToolStrip)    -->
        <!--    trái: menu chữ + nút điều hướng nghiệp vụ; phải: thao tác hệ thống -->
        <!-- ============================================================ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center" FontSize="12.5">
                    <MenuItem Header="{DynamicResource Str_MainMenu_System}">
                        <MenuItem Header="{DynamicResource Str_MainMenu_Language}">
                            <MenuItem Header="{DynamicResource Str_Lang_VI}" IsCheckable="False" IsChecked="{Binding IsLanguageVi, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="vi-VN"/>
                            <MenuItem Header="{DynamicResource Str_Lang_EN}" IsCheckable="False" IsChecked="{Binding IsLanguageEn, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="en-US"/>
                            <MenuItem Header="{DynamicResource Str_Lang_JA}" IsCheckable="False" IsChecked="{Binding IsLanguageJa, Mode=OneWay}"
                                      Command="{Binding SetLanguageCommand}" CommandParameter="ja-JP"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_Refresh}" InputGestureText="F5" Command="{Binding RefreshCommand}"/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_CloseTab}" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}"/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_CloseAllTabs}" Command="{Binding CloseAllTabsCommand}"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_Logout}" InputGestureText="Ctrl+L" Command="{Binding LogoutCommand}"/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_Exit}" InputGestureText="Alt+F4" Command="{Binding ExitCommand}"/>
                    </MenuItem>

                    <MenuItem Header="{DynamicResource Str_MainMenu_Operations}"
                              ItemsSource="{Binding OperationsMenu.Items}"
                              ItemContainerStyle="{StaticResource NavMenuItemStyle}"
                              Visibility="{Binding OperationsMenu.IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    <MenuItem Header="{DynamicResource Str_MainMenu_Catalog}"
                              ItemsSource="{Binding CatalogMenu.Items}"
                              ItemContainerStyle="{StaticResource NavMenuItemStyle}"
                              Visibility="{Binding CatalogMenu.IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    <MenuItem Header="{DynamicResource Str_MainMenu_Reports}"
                              ItemsSource="{Binding ReportsMenu.Items}"
                              ItemContainerStyle="{StaticResource NavMenuItemStyle}"
                              Visibility="{Binding ReportsMenu.IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
                    <MenuItem Header="{DynamicResource Str_MainMenu_Admin}"
                              ItemsSource="{Binding AdminMenu.Items}"
                              ItemContainerStyle="{StaticResource NavMenuItemStyle}"
                              Visibility="{Binding AdminMenu.IsVisible, Converter={StaticResource BoolToVisConverter}}"/>

                    <MenuItem Header="{DynamicResource Str_MainMenu_Help}">
                        <MenuItem Header="{DynamicResource Str_MainMenu_Shortcuts}" InputGestureText="F1" Command="{Binding ShowShortcutsCommand}"/>
                        <MenuItem Header="{DynamicResource Str_MainMenu_About}" Command="{Binding AboutCommand}"/>
                    </MenuItem>
                </Menu>

                <!-- Vạch ngăn giữa menu chữ và nút điều hướng -->
                <Border Grid.Column="1" Width="1" Height="22" Margin="8,0" Background="{StaticResource DividerBrush}" VerticalAlignment="Center"/>

                <!-- Nút điều hướng nghiệp vụ (chỉ icon; tên và phím tắt nằm trong tooltip), ẩn theo quyền -->
                <ToolBar Grid.Column="2" Style="{StaticResource FlatToolBarStyle}" ItemsSource="{Binding ToolbarItems}">
                    <ToolBar.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource FlatToolButtonStyle}" Padding="9,7"
                                    Command="{Binding OpenCommand}"
                                    Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}">
                                <Button.ToolTip>
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                        <Run Text="{Binding ShortcutText, Mode=OneWay}" Foreground="{StaticResource TextDimBrush}"/>
                                    </TextBlock>
                                </Button.ToolTip>
                                <Path Data="{Binding IconData}" Style="{StaticResource ToolbarIconStyle}"/>
                            </Button>
                        </DataTemplate>
                    </ToolBar.ItemTemplate>
                </ToolBar>

                <!-- Thao tác hệ thống, tách hẳn sang phải -->
                <ToolBar Grid.Column="4" Style="{StaticResource FlatToolBarStyle}">
                    <Button Style="{StaticResource FlatToolButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="{DynamicResource Str_Tooltip_Refresh}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                            <TextBlock Text="{DynamicResource Str_Dash_Btn_Refresh}" Style="{StaticResource ToolLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatToolButtonStyle}" Command="{Binding CloseTabCommand}" ToolTip="Ctrl+W">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolbarIconStyle}"
                                  Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            <TextBlock Text="{DynamicResource Str_MainMenu_CloseTab}" Style="{StaticResource ToolLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Margin="6,0" Background="{StaticResource DividerBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource FlatToolButtonStyle}" Command="{Binding LogoutCommand}" ToolTip="{DynamicResource Str_Tooltip_Logout}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolbarIconStyle}" Fill="{StaticResource ErrorTextBrush}"
                                  Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.1 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z"/>
                            <TextBlock Text="{DynamicResource Str_Dash_Btn_Logout}" Style="{StaticResource ToolLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </ToolBar>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- 2. THANH TRẠNG THÁI (StatusStrip): chữ nhạt, không tranh chấp với nội dung -->
        <!-- ============================================== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F8FAFC" Foreground="{StaticResource TextDimBrush}"
                   BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" FontSize="11.5" Padding="6,1">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Họ tên + mã vai trò: không lặp tên vai trò khi họ tên đã là "Quản trị viên ..." -->
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{DynamicResource Str_Status_User}"/>
                    <Run Text="{Binding CurrentUserFullName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                    <Run Text="·"/>
                    <Run Text="{Binding CurrentUserRole, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator Background="{StaticResource DividerBrush}"/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="{DynamicResource Str_Status_Screen}"/>
                    <Run Text="{Binding CurrentScreenTitle, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/>
                </TextBlock>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="ClockText" MinWidth="120" TextAlignment="Right"/>
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" Background="{StaticResource DividerBrush}"/>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock>
                    <Run Text="SmartPS v"/><Run Text="{Binding AppVersion, Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- ============================================== -->
        <!-- 3. VÙNG LÀM VIỆC: MỖI PHÂN HỆ MỘT THẺ (TabControl) -->
        <!-- ============================================== -->
        <Grid Background="{StaticResource AppBackgroundBrush}">
            <TabControl ItemsSource="{Binding OpenTabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Style="{StaticResource FlatTabControlStyle}"
                        Visibility="{Binding HasOpenTabs, Converter={StaticResource BoolToVisConverter}}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <!-- Nhấn chuột giữa để đóng thẻ -->
                            <StackPanel.InputBindings>
                                <MouseBinding Gesture="MiddleClick"
                                              Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                            </StackPanel.InputBindings>
                            <Path Data="{Binding Item.IconData}" Width="13" Height="13" Stretch="Uniform"
                                  Fill="{StaticResource TextBrandBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Item.Title}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource TabCloseButtonStyle}"
                                    ToolTip="{DynamicResource Str_MainMenu_CloseTab}"
                                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding Content}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- Chưa mở thẻ nào -->
            <TextBlock Text="{DynamicResource Str_Main_NoTabHint}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="{StaticResource TextDimBrush}"
                       Visibility="{Binding HasOpenTabs, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
        </Grid>
    </DockPanel>
</Window>
