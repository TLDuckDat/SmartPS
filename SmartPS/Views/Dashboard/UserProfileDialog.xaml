<Window x:Class="SmartPS.Views.Dashboard.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:SmartPS.Views.Common"
        Title="{DynamicResource Str_Profile_WindowTitle}"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_Profile_HeaderTitle}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="{DynamicResource Str_Profile_HeaderSubtitle}"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel Margin="20,18">
                <TextBlock Text="{DynamicResource Str_Profile_UsernameLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#475569"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding Username, Mode=OneWay}"
                         IsReadOnly="True"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,14"/>

                <TextBlock Text="{DynamicResource Str_Profile_FullNameLabel}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           Margin="0,0,0,5"/>
                <TextBox Text="{Binding FullName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Profile_PhoneLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Str_Profile_EmailLabel}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Profile_PasswordSection}"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="{DynamicResource Str_Profile_PasswordHint}"
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,10"/>

                        <TextBlock Text="{DynamicResource Str_Profile_CurrentPasswordLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,4"/>
                        <common:RevealPasswordBox Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  InputHeight="36"
                                                  InputBackground="#FFFFFF"
                                                  InputBorderBrush="#CBD5E1"
                                                  Margin="0,0,0,10"/>

                        <TextBlock Text="{DynamicResource Str_Profile_NewPasswordLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,4"/>
                        <common:RevealPasswordBox Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  InputHeight="36"
                                                  InputBackground="#FFFFFF"
                                                  InputBorderBrush="#CBD5E1"
                                                  Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0"
                                         Value="{Binding PasswordStrengthScore, Mode=OneWay}"
                                         Minimum="0"
                                         Maximum="4"
                                         Height="7"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding PasswordStrengthText, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="#64748B"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{DynamicResource Str_Profile_ConfirmPasswordLabel}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#475569"
                                   Margin="0,0,0,4"/>
                        <common:RevealPasswordBox Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  InputHeight="36"
                                                  InputBackground="#FFFFFF"
                                                  InputBorderBrush="#CBD5E1"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="{DynamicResource Str_Btn_Cancel}"
                        MinWidth="85"
                        Margin="4,0"
                        IsCancel="True"
                        Command="{Binding CancelCommand}"/>
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="{DynamicResource Str_Btn_Save}"
                        MinWidth="120"
                        Margin="4,0"
                        IsDefault="True"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
