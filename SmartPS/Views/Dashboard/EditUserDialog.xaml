<Window x:Class="SmartPS.Views.Dashboard.EditUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:SmartPS.Views.Common"
        mc:Ignorable="d"
        Title="Chỉnh sửa thông tin người dùng"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header banner -->
            <RowDefinition Height="*"/>    <!-- Content form -->
            <RowDefinition Height="Auto"/> <!-- Footer actions -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Header Section -->
        <Border Grid.Row="0"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <StackPanel>
                <TextBlock Text="CẬP NHẬT THÔNG TIN TÀI KHOẢN"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Cập nhật họ tên, vai trò hệ thống hoặc đổi mật khẩu tài khoản"
                           FontSize="12"
                           Foreground="#64748B"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ROW 1: Content Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Margin="20,18">

                <!-- Tên đăng nhập & ID (Chỉ xem) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Mã User (ID)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="UserIdInput" Style="{StaticResource ModernTextBoxStyle}" IsEnabled="False" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Tên đăng nhập (Cố định)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="UsernameInput" Style="{StaticResource ModernTextBoxStyle}" IsEnabled="False" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <!-- Họ và tên -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Họ và tên (*)" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                    <TextBox x:Name="FullNameInput" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <!-- Vai trò (Role) & Trạng thái (IsActive) -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vai trò -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Vai trò (Role) (*)" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="RoleComboBox"
                                  DisplayMemberPath="RoleName"
                                  Height="36"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1"/>
                    </StackPanel>

                    <!-- Trạng thái -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Trạng thái tài khoản" FontSize="12" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <ComboBox x:Name="StatusComboBox"
                                  Height="36"
                                  FontSize="13"
                                  VerticalContentAlignment="Center"
                                  Background="#FFFFFF"
                                  BorderBrush="#CBD5E1">
                            <ComboBoxItem Content="Đang hoạt động" IsSelected="True"/>
                            <ComboBoxItem Content="Tạm khóa (Vô hiệu hóa)"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Khung đổi mật khẩu mới (Tùy chọn) -->
                <Border Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="Đổi mật khẩu mới (Tùy chọn)"
                                   FontSize="12.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Nếu muốn giữ nguyên mật khẩu cũ, vui lòng để trống 2 ô bên dưới."
                                   FontSize="11.5"
                                   Foreground="#64748B"
                                   Margin="0,2,0,10"/>

                        <!-- Mật khẩu mới (Có nút Ẩn/Hiện mật khẩu) -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Mật khẩu mới (Tối thiểu 6 ký tự)" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="NewPasswordInput"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="#FFFFFF"
                                                      InputBorderBrush="#CBD5E1"/>
                        </StackPanel>

                        <!-- Xác nhận mật khẩu mới (Có nút Ẩn/Hiện mật khẩu) -->
                        <StackPanel>
                            <TextBlock Text="Nhập lại mật khẩu mới" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <common:RevealPasswordBox x:Name="ConfirmPasswordInput"
                                                      InputHeight="36"
                                                      InputCornerRadius="4"
                                                      InputBackground="#FFFFFF"
                                                      InputBorderBrush="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ROW 2: FOOTER ACTIONS -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}"
                        Content="Hủy bỏ"
                        MinWidth="85"
                        Margin="4,0"
                        Click="CancelButton_Click"/>

                <Button x:Name="SaveButton"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Content="Lưu thay đổi"
                        MinWidth="120"
                        Margin="4,0"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
