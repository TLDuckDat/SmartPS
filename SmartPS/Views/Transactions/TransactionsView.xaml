<UserControl x:Class="SmartPS.Views.Transactions.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource AppBackgroundBrush}">
        <StackPanel Margin="28,24">
            <!-- Header Phân Hệ -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="24,18"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Str_Menu_Transactions}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Sổ cái thu chi, đối soát luồng tiền mặt và giao dịch thanh toán trực tuyến VietQR" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource IceBadgeBackgroundBrush}" BorderBrush="{StaticResource IceBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                        <TextBlock Text="Phân hệ MVVM độc lập" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextBrandBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Khung Thông Tin Module Chuẩn Kiến Trúc -->
            <Border Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Sổ Cái Kế Toán &amp; Đối Soát Giao Dịch Bãi Xe" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Phân hệ Giao dịch &amp; thanh toán đã được cấu hình độc lập theo mô hình MVVM, sẵn sàng nạp dòng tiền và sao kê từ các thực thể cơ sở dữ liệu."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="CÁC THỰC THỂ CƠ SỞ DỮ LIỆU LIÊN QUAN:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="• ParkingSession: Ghi nhận thanh toán cước lượt xe vãng lai (Tiền mặt, quét mã VietQR động)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• MonthlyTicket: Ghi nhận giao dịch thanh toán phát hành hoặc gia hạn hợp đồng vé tháng" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• PricingRule: Căn cứ tính cước phí và xuất biên lai thanh toán" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• User: Thu ngân / Nhân viên ca trực phụ trách kết ca và chốt sổ quỹ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Giao diện sẽ được gắn kết trực tiếp với tầng Service và DbContext khi triển khai nghiệp vụ cụ thể cho phân hệ này."
                               FontSize="12" Foreground="{StaticResource TextDimBrush}" FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
