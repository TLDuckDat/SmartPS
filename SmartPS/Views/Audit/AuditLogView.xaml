<UserControl x:Class="SmartPS.Views.Audit.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================== -->
        <!-- ROW 0: BỘ LỌC NHẬT KÝ                           -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Margin="16,14,16,12" Padding="16"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str_Audit_Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Str_Audit_Subtitle}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                            Content="{DynamicResource Str_Audit_Verify}"
                            Height="32" Padding="14,0" FontSize="11.5"
                            Command="{Binding VerifyCommand}"/>
                </Grid>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_FromDate}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="130" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_ToDate}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="130" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_User}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}" Width="140" Height="30" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_Action}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}"
                                  DisplayMemberPath="Label" Width="190" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_Outcome}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding SelectedOutcome}"
                                  DisplayMemberPath="Label" Width="120" Height="30"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="{DynamicResource Str_Audit_Search}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="30"
                                 VerticalContentAlignment="Center" ToolTip="{DynamicResource Str_Audit_SearchHint}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Str_Audit_Apply}"
                                Height="30" Padding="14,0" Margin="0,0,8,0" FontSize="11.5" Command="{Binding ApplyFilterCommand}"/>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Audit_Clear}"
                                Height="30" Padding="14,0" FontSize="11.5" Command="{Binding ClearFilterCommand}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ============================================== -->
        <!-- ROW 1: BẢNG NHẬT KÝ (CHỈ ĐỌC), CHI TIẾT, PHÂN TRANG -->
        <!-- ============================================== -->
        <Border Grid.Row="1" Margin="16,0,16,16" Padding="16"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="90"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          RowHeight="32"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          Background="Transparent"
                          BorderThickness="1"
                          BorderBrush="{StaticResource DividerBrush}"
                          RowHeaderWidth="0"
                          HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding AuditLogId}" Width="70">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Id}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding OccurredAtUtc, Converter={StaticResource UtcToVietnamTimeConverter}}" Width="150">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Time}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Username}" Width="120">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_User}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding RoleName}" Width="90">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Role}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Action}" Width="200">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Action}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Width="220">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Entity}"/></DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding EntityType, Mode=OneWay}"/>
                                        <Run Text="{Binding EntityId, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Outcome}" Width="90">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Outcome}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding MachineName}" Width="*">
                            <DataGridTextColumn.HeaderTemplate>
                                <DataTemplate><TextBlock Text="{DynamicResource Str_Audit_Col_Machine}"/></DataTemplate>
                            </DataGridTextColumn.HeaderTemplate>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Phân trang -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,10">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Audit_PrevPage}"
                            Height="28" Padding="12,0" FontSize="11.5" Command="{Binding PrevPageCommand}"/>
                    <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center" Margin="12,0"
                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="{DynamicResource Str_Audit_NextPage}"
                            Height="28" Padding="12,0" FontSize="11.5" Command="{Binding NextPageCommand}"/>
                </StackPanel>

                <!-- Chi tiết JSON của bản ghi đang chọn -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str_Audit_Details}" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                    <TextBox Grid.Row="1" Text="{Binding SelectedDetailsText, Mode=OneWay}" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource AppBackgroundBrush}"
                             BorderBrush="{StaticResource DividerBrush}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
